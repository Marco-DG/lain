// EXPECT: [E002]
type H { mov raw *u8 }

func close_it(mov {raw} H) {
}

func inloop(mov h H, n i32) {
    var i = 0
    while i < n {
        close_it(mov h)
        i = i + 1
    }
}

func main() i32 { return 0 }
