// CLAIM: spec 08 constraint — `idx in 0..arr.len` guards `arr[idx]` EXACTLY; `arr[idx + k]` for
// CLAIM: k != 0 is not covered and needs its own verification. This is the probe that would catch
// CLAIM: the guard being widened by accident, which would be unsound rather than merely imprecise.
// CLAIM: Written `in arr` until I.78 retired the container form; the boundary it tests is the same.
// EXPECT: [E085]
func f(a i32[8], i usize) i32 {
    if i in 0..a.len {
        return a[i + 1]
    }
    return 0
}
func main() i32 { return 0 }
