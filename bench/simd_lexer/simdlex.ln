// SIMD lexer core (P4, proof_licensed_performance.md §6). Hybrid: SIMD skips the
// long whitespace runs (load 16 bytes → detect ws → movemask → ctz to the first
// non-ws), scalar scans the short, dense token bodies.
//
// Safety, exactly per the doctrine — NOW FULLY PROVEN (P2b):
//   • scalar reads `src[i]` are `in`-guarded → VRA proves them (no checks emitted).
//   • the SIMD scan loads (`scan_to`) are proven via a last-byte in-guard
//     `(i + 15) in src` — ZERO `unsafe`, zero runtime checks. The corrected lexer
//     (count_tokens_smart / tokenize) has no `unsafe` at all.
//   • (the deprecated naive `count_tokens` below keeps one `unsafe` block, only to
//     show the old per-token form the measurement rejected.)
//
// Buffer is a fixed `u8[4096]`; content length carries `n < 4097` (content ≤
// capacity) — the refinement the callers thread so the wide loads are in-bounds.

// Token kinds — SoA output stores one of these per token (1 byte each).
KIND_IDENT  u8 = 0
KIND_NUMBER u8 = 1
KIND_OP     u8 = 2
KIND_STRING  u8 = 3
KIND_KEYWORD u8 = 4

func is_ws(c u8) bool    { return c == 32 or c == 9 or c == 10 or c == 13 }
func is_alpha(c u8) bool { return (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95 }
func is_digit(c u8) bool { return c >= 48 and c <= 57 }
func is_alnum(c u8) bool { return is_alpha(c) or is_digit(c) }

// SIMD scan to the first byte == `term` at or after `start` (16 bytes at a time,
// movemask + ctz). This is SIMD used the RIGHT way — on a genuinely-long run (a
// string / comment body), amortized over many bytes.
//
// P2b: the loads are now PROVEN safe — NO `unsafe`. The loop guard `(i + 15) in src`
// proves the last byte of the 16-byte load is in bounds; for an unsigned `i` that
// plus contiguity proves the whole `[i, i+16)` load, at zero runtime cost. The
// `i +% 16 <= n` bound keeps the SIMD path within the content (the scalar tail
// finishes the final partial chunk).
proc scan_to(src u8[4096], n u32 < 4097, start u32 < 4097, term u8) u32 {
    var i u32 = start
    while (i + 15) in src and i +% 16 <= n {
        var hit u32 = @movemask(@load(u8x16, src, i) == term) & (65535 as u32)
        if hit != 0 {
            i = i +% (@ctz(hit) as u32)
            break
        }
        i = i +% 16
    }
    while i in src and i < n and src[i] != term { i = i +% 1 }   // scalar tail (proven)
    return i
}

// CORRECTED lexer (per the measurement): a tight SCALAR core for the short, dense
// tokens, and SIMD invoked ONLY on long runs (here: string bodies). Matches the
// scalar core on dense code (no per-token SIMD tax) and beats it on long strings.
proc count_tokens_smart(src u8[4096], n u32 < 4097) u32 {
    var count u32 = 0
    var i     u32 = 0
    while i < n {
        while i in src and i < n and is_ws(src[i]) { i = i +% 1 }   // scalar ws skip
        if i >= n { break }
        if i in src {
            var c u8 = src[i]
            var j u32 = i +% 1                               // peek index (named, so `j in src` guards src[j])
            if c == 47 and j in src and j < n and src[j] == 47 {
                i = scan_to(src, n, i +% 2, 10)              // '//' line comment → SIMD-skip to \n
                // comments are trivia: skipped, not counted
            } else if c == 47 and j in src and j < n and src[j] == 42 {
                i = i +% 2                                   // '/*' block comment → SIMD-scan to '*/'
                var done bool = false
                while i < n and !done {
                    i = scan_to(src, n, i, 42)               // find the next '*'
                    var k u32 = i +% 1
                    if k in src and k < n and src[k] == 47 {
                        i = i +% 2
                        done = true
                    } else if i >= n {
                        done = true
                    } else {
                        i = i +% 1
                    }
                }
            } else if c == 34 {                              // '"' → SIMD-scan the body
                i = scan_to(src, n, i +% 1, 34)
                if i in src and i < n { i = i +% 1 }         // consume the closing quote
                count = count +% 1
            } else if is_alpha(c) {
                while i in src and i < n and is_alnum(src[i]) { i = i +% 1 }
                count = count +% 1
            } else if is_digit(c) {
                while i in src and i < n and is_digit(src[i]) { i = i +% 1 }
                count = count +% 1
            } else {
                i = i +% 1
                count = count +% 1
            }
        }
    }
    return count
}

proc count_tokens(src u8[4096], n u32) u32 {
    var count u32 = 0
    var i     u32 = 0
    while i < n {
        // --- SIMD whitespace skip: jump whole 16-byte all-whitespace chunks ---
        unsafe {
            while i +% 16 <= n {
                var v  u8x16 = @load(u8x16, src, i)
                var ws u8x16 = (v == 32) | (v == 9) | (v == 10) | (v == 13)
                var nonws u32 = (~@movemask(ws)) & (65535 as u32)     // 1s at non-ws lanes
                if nonws != 0 {
                    i = i +% (@ctz(nonws) as u32)                     // jump to first non-ws
                    break
                }
                i = i +% 16                                          // all 16 ws — skip block
            }
        }
        // scalar tail: finish skipping whitespace past the last full chunk (proven)
        while i in src and i < n and is_ws(src[i]) { i = i +% 1 }
        if i >= n { break }

        // --- scalar token scan (all reads in-guarded) ---
        if i in src {
            var c u8 = src[i]
            if is_alpha(c) {
                while i in src and i < n and is_alnum(src[i]) { i = i +% 1 }
            } else if is_digit(c) {
                while i in src and i < n and is_digit(src[i]) { i = i +% 1 }
            } else {
                i = i +% 1                                            // single-char operator
            }
            count = count +% 1
        }
    }
    return count
}

// Keyword recognition: match an identifier `src[start..start+len)` against a small
// Lain keyword set. Reads are `in`-guarded per byte (compound guards), so no
// refinement on `start` is needed and identifiers at the very buffer end correctly
// fall through to KIND_IDENT. (A word-sized u64/SIMD compare is the P5 optimization,
// gated on measurement.)
func kw_kind(src u8[4096], start u32 < 4090, len u32) u8 {
    if len == 2 {
        var a u8 = src[start]
        var b u8 = src[start + 1]
        if a == 105 and b == 102 { return KIND_KEYWORD }                       // if
    } else if len == 3 {
        var a u8 = src[start]
        var b u8 = src[start + 1]
        var c u8 = src[start + 2]
        if a == 102 and b == 111 and c == 114 { return KIND_KEYWORD }          // for
        if a == 118 and b == 97  and c == 114 { return KIND_KEYWORD }          // var
    } else if len == 4 {
        var a u8 = src[start]
        var b u8 = src[start + 1]
        var c u8 = src[start + 2]
        var d u8 = src[start + 3]
        if a == 102 and b == 117 and c == 110 and d == 99  { return KIND_KEYWORD }  // func
        if a == 112 and b == 114 and c == 111 and d == 99  { return KIND_KEYWORD }  // proc
        if a == 101 and b == 108 and c == 115 and d == 101 { return KIND_KEYWORD }  // else
        if a == 116 and b == 121 and c == 112 and d == 101 { return KIND_KEYWORD }  // type
    } else if len == 5 {
        var a u8 = src[start]
        var b u8 = src[start + 1]
        var c u8 = src[start + 2]
        var d u8 = src[start + 3]
        var e u8 = src[start + 4]
        if a == 119 and b == 104 and c == 105 and d == 108 and e == 101 { return KIND_KEYWORD }  // while
    } else if len == 6 {
        var a u8 = src[start]
        var b u8 = src[start + 1]
        var c u8 = src[start + 2]
        var d u8 = src[start + 3]
        var e u8 = src[start + 4]
        var f u8 = src[start + 5]
        if a == 114 and b == 101 and c == 116 and d == 117 and e == 114 and f == 110 { return KIND_KEYWORD }  // return
    }
    return KIND_IDENT
}

// Real tokenizer with SoA output (the Zig-style memory win): one KIND_* byte per
// token in `kinds`, the token's start offset in `starts`, and NO length stored — a
// token's length is the gap to the next start, or a cheap re-lex. Comments are
// trivia (skipped, no token). Returns the token count; output caps at 1024 tokens.
proc tokenize(src u8[4096], n u32 < 4090, var kinds u8[1024], var starts u32[1024]) u32 {
    var count u32 = 0
    var i     u32 = 0
    while i < n {
        while i in src and i < n and is_ws(src[i]) { i = i +% 1 }
        if i >= n { break }
        if i in src {
            var c u8 = src[i]
            var start u32 = i
            var j u32 = i +% 1
            if c == 47 and j in src and j < n and src[j] == 47 {
                i = scan_to(src, n, i +% 2, 10)              // line comment — skip
            } else if c == 47 and j in src and j < n and src[j] == 42 {
                i = i +% 2                                   // block comment — skip
                var done bool = false
                while i < n and !done {
                    i = scan_to(src, n, i, 42)
                    var k u32 = i +% 1
                    if k in src and k < n and src[k] == 47 {
                        i = i +% 2
                        done = true
                    } else if i >= n {
                        done = true
                    } else {
                        i = i +% 1
                    }
                }
            } else {
                var kind u8 = KIND_OP
                if c == 34 {
                    i = scan_to(src, n, i +% 1, 34)
                    if i in src and i < n { i = i +% 1 }
                    kind = KIND_STRING
                } else if is_alpha(c) {
                    while i in src and i < n and is_alnum(src[i]) { i = i +% 1 }
                    kind = kw_kind(src, start, i -% start)   // Keyword or Ident
                } else if is_digit(c) {
                    while i in src and i < n and is_digit(src[i]) { i = i +% 1 }
                    kind = KIND_NUMBER
                } else {
                    i = i +% 1
                    kind = KIND_OP
                }
                if count in kinds and count in starts {      // SoA write, parallel arrays
                    kinds[count] = kind
                    starts[count] = start
                    count = count +% 1
                }
            }
        }
    }
    return count
}
