// SIMD whitespace counter — the P1 milestone kernel for the proof-licensed
// performance doctrine (internal/design/proof_licensed_performance.md).
//
// Counts space (0x20) bytes over `n` bytes at `data`, 32 lanes at a time:
//   @load  → 32 bytes into a u8x32   (unaligned load, one vmovdqu)
//   == 32  → per-lane compare mask    (scalar broadcast, GCC/Clang vector ext)
//   @movemask → 32-bit lane bitmask   (_mm256_movemask_epi8)
//   @popcount → set bits              (__builtin_popcount)
//
// No `unsafe`, no bounds checks emitted. `n` is assumed a multiple of 32 (the
// benchmark buffer is); a tail loop is future work once @load is made
// provably-safe by the P2 padded-buffer invariant.
proc count_ws(data *u8, n usize) u64 {
    var total u64  = 0
    var i     usize = 0
    while i +% 32 <= n {
        var bits u32 = @movemask(@load(u8x32, data, i) == 32)
        total = total +% (@popcount(bits) as u64)
        i = i +% 32
    }
    return total
}
