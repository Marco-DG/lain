// Branchless padded vs guarded wide SIMD scan — does the proof-licensed branchless
// tail (constraint-chaining, no in-guard, no scalar cleanup) actually run faster?
// Both count whitespace (space=32) 16 bytes at a time via @load+@movemask+@popcount.

// GUARDED: the P2b form. Wide loads proven by the last-byte in-guard `(i+15) in buf`;
// a scalar tail finishes the final partial chunk. Two comparisons + a branch per
// 16-byte block, plus the tail loop.
proc count_guarded(buf u8[4096], n u32 < 4097) u32 {
    var i u32 = 0
    var t u32 = 0
    while (i + 15) in buf and i +% 16 <= n {
        t = t +% (@popcount(@movemask(@load(u8x16, buf, i) == 32) & (65535 as u32)) as u32)
        i = i +% 16
    }
    while i < n {
        if buf[i] == 32 { t = t +% 1 }
        i = i +% 1
    }
    return t
}

// BRANCHLESS: padded buffer u8[4112] (4096 usable + 16 zero pad). The scan reads
// whole 16-byte blocks to the end, over-reading the final block into the zeroed
// pad (space≠0 so it never miscounts). ONE comparison per block, NO tail, NO
// in-guard — the wide load is proven check-free by chaining `i < n` with `n<4097`.
proc count_branchless(buf u8[4112], n u32 < 4097) u32 {
    var i u32 = 0
    var t u32 = 0
    while i < n {
        t = t +% (@popcount(@movemask(@load(u8x16, buf, i) == 32) & (65535 as u32)) as u32)
        i = i +% 16
    }
    return t
}
