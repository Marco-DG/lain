extern proc libc_printf(fmt *u8, ...) i32
func pick(p *u8, present bool) *u8 | none {
    if present { return p }
    return none
}
proc main() i32 {
    var a *u8 | none = pick("x", true)
    var b *u8 | none = pick("x", false)
    if a { libc_printf("a=some\n") }
    if b { libc_printf("b=some\n") }
    return 0
}
