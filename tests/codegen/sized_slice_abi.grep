< __len_src;
// slide: out i32[n - 1] -> loop bound is the derived n - 1, and there is no __len_out
< n - 1;
tests_codegen_sized_slice_abi_slide(size_t n, const int32_t * restrict src, int32_t * restrict out)
// concat_prefix: two named lengths, and out carries none of its own
