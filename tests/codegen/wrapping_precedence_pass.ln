// A MISCOMPILE, and a silent one: `a +% (b & 1)` emitted `(a + b & 1)`. The wrapping path
// parenthesised the whole expression but not its operands, and in C `+` binds tighter than
// `&` — so the emitted code computed `(a + b) & 1`. With a = 4, b = 3 that is 1, not 5.
//
// It never showed on the plain `+` because Path-F casts each operand
// (`(uint64_t)(a) + (uint64_t)(b & 1)`) and a cast parenthesises what follows; the saturating
// operators are safe for the same reason. Only `+%`, `-%` and `*%` concatenated their operands
// raw.
//
// ★ The exit-code suite called the wrong-answer program a PASS. `popcount_shift_termination`
// computes `count = count +% (x & 1)` and returned 0 instead of 8 — a `_pass` test whose whole
// point is the answer, passing because the answer happened to be 0 and 0 is the success code.
// The emit gate caught it by DIFFERENTIAL against the new backend, which was right all along.
// This test asserts the VALUES.
extern proc libc_printf(fmt *u8, ...) i32
proc main() i32 {
    var a u32 = 4
    var b u32 = 3
    var w u32 = a +% (b & 1)        // 4 + 1 = 5, not (4+3)&1 = 1
    var x u32 = a -% (b & 1)        // 4 - 1 = 3
    var y u32 = a *% (b & 1)        // 4 * 1 = 4
    var z u32 = a +% (b >> 1)       // 4 + 1 = 5
    libc_printf("%u %u %u %u\n", w, x, y, z)
    if w == 5 and x == 3 and y == 4 and z == 5 { return 0 }
    return 1
}
