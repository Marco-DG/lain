// EXPECT: [E130]
// ★ A DECLARED ROW IS AN UPPER BOUND, AND IT IS CHECKED.
//
// This one declares `io` and then also diverges — the unbounded `while` has no measure. Widening
// the bound by one effect does not license the others, so the declared-vs-inferred comparison
// reports exactly what the clause fails to cover ("it also has: diverge") rather than the first
// effect it happens to find.
//
// Without this the B.1 change would have been a hole rather than a feature: `effects io` would
// have meant "stop checking effects on this function".
extern proc libc_printf(fmt *u8, ...) i32
func loops(n i32) i32 effects io {
    var i i32 = 0
    while i < n { i = i +% 1 }
    return libc_printf("%d\n", i)
}
proc main() i32 { return loops(3) }
