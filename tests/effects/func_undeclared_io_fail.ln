// EXPECT: [E011]
// ★ THE DEFAULT IS STILL ∅, which is the half that keeps the guarantee.
//
// Without the clause a `func`'s effect bound is empty, so calling a proc is an undeclared
// effect and refused. If this were accepted, `effects` would have become a NARROWING clause on
// an unconstrained default — purity as opt-in — and the language's headline claim would hold
// only for functions whose authors remembered to ask for it.
//
// The diagnostic names the fix rather than the rule: write `effects io`, or keep it pure.
extern proc libc_printf(fmt *u8, ...) i32
func shout(x i32) i32 {
    return libc_printf("%d\n", x)
}
proc main() i32 { return shout(7) }
