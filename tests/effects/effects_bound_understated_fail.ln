// EXPECT: [E130]
// Declaring FEWER effects than the body has is the error — an annotation the compiler trusts
// and never verifies is defect D-4, so the bound is checked against the inferred row. Same
// rule as F1's `in` clause: believed on an extern, checked wherever there is a body.
extern proc libc_printf(fmt *u8, ...) i32
proc noisy(s u8[:0]) effects {
    libc_printf(s.data)
}
proc main() i32 { return 0 }
