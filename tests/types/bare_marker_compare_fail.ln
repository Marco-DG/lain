// EXPECT: [E012]
// EXPECT-TEXT: cannot use '==' on the union 'Small | NotFound'. Match it with `case` instead.
// I.103: `NotFound == 0` compiled and compared the marker's niche, a representation the language
// hides (spec 07 refuses `==` on enums for exactly that reason).
type Small = u8 < 200

func find(fail bool, v Small) Small | NotFound {
    if fail {
        return NotFound
    }
    return v
}

func main() i32 {
    b = NotFound == 0
    if b {
        return 1
    }
    return 0
}
