// EXPECT: [E100]
// spec: §7.5 — a fat slice carries its own length and is not a raw pointer, so
// it takes no `*`. `*T[]` (and `*T[n]`, `*T[>= n]`) used to be silent synonyms
// of `T[]`; the `*` is now rejected. It stays valid only for `*T`, `*T[N]`
// (fixed length), and `*T[:S]` (sentinel string).
proc f(s *u8[]) usize {
    return s.len
}
proc main() i32 { return 0 }
