// EXPECT: [E100]
// spec: §7.5 — `*` is a RAW POINTER and only that. Arrays and slices are always
// passed by reference, so they never take a `*`: write `T[]`, `T[n]`, `T[N]`, or
// `T[:S]` with no `*`. `*` is reserved for raw pointers (`*T`, `*void`, function
// pointers). Here `*u8[]` (a `*` before a slice) is rejected.
proc f(s *u8[]) usize {
    return s.len
}
proc main() i32 { return 0 }
