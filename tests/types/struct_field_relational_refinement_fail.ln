// EXPECT: [E121]
// A field invariant the compiler ignores is an unpaid assume. One that names another field
// parsed and then did nothing at all — `BumpLike(5, 10)` compiled clean with `pos usize <= cap`
// declared, and no proof could use it either. It was refused as E132 while relational field
// invariants were not built. They are built now (2026-09-28): the declaration is accepted and
// ENFORCED — asserted at construction and at every write to either field, assumed at reads —
// so the program that used to compile clean is refused where the invariant breaks.
type BumpLike {
    cap usize,
    pos usize <= cap
}

func main() i32 {
    b = BumpLike(5, 10)
    return 0
}
