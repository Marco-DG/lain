// EXPECT: [E085]
// A plain slice promises no terminator: the same scan as sentinel_scan_pass.ln may read past it.
func cstrlen(s u8[]) usize {
    var i usize = 0
    while s[i] != 0 {
        i = i + 1
    }
    return i
}

func main() i32 {
    var s = "hello"
    if cstrlen(s[0..s.len]) != 5 { return 1 }
    return 0
}
