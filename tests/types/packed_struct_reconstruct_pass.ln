// Sprint 19: packed struct mutation via explicit reconstruction. (This comment used to say Lain
// REJECTS `r.pin1 = 9`; nothing ever did, and spec 07 defines that write — a read-modify-write
// of bits 2-3. Reconstruction is simply the other way to spell it.)

[packed]
type GpioModer {
    pin0 u2
    pin1 u2
    pin2 u2
    pin3 u2
}
assert @sizeof(GpioModer) == 1

func main() i32 {
    var r = GpioModer(1, 2, 3, 0)
    // To modify pin1, reconstruct:
    var r2 = GpioModer(r.pin0, 3, r.pin2, r.pin3)
    var p = r2.pin1
    return 0
}
