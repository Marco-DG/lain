// EXPECT: [E089]
// A `u8[:0]` promises a trailing NUL so `.data` is safe for a C string API. An
// arbitrary fixed `u8[N]` buffer has no such terminator — coercing it to `u8[:0]`
// would let printf "%s"/open/strlen read past the buffer (leaking memory). Reject.
extern proc libc_printf(fmt *u8, ...) i32
proc show(msg u8[:0]) {
    libc_printf("%s\n", msg.data)
}
proc main() i32 {
    var buf u8[5] = [65, 66, 67, 68, 69]
    show(buf)
    return 0
}
