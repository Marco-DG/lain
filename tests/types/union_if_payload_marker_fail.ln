// EXPECT: [E063]
// EXPECT-TEXT: Error Ln 16, Col 9: return from function value may be a marker; test it (`if r { … }`) or match it (`case r { … }`) before using it as 'i32'.
// I.163: `if r` narrowed this union as if it had one marker (a marker with fields was counted as
// the payload), and lowering never rebound the local: lain accepted it, the C returned the union
// where an i32 was declared, and --interpret returned 0 for 9. It has two markers.

func fe(k i32) i32 | NotFound | Err(code i32) {
    if k == 1 { return NotFound }
    if k == 2 { return Err(77) }
    return k
}

func get(k i32) i32 {
    r i32 | NotFound | Err(code i32) = fe(k)
    if r {
        return r
    }
    return -1
}

func main() i32 {
    return get(9)
}
