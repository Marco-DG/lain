// VRA uses the concrete i32 type's range for a call. `n + 1` is only provably
// non-overflowing when n is bounded away from i32 max, so the parameter carries
// a refinement; VRA then proves the addition fits. (An unconstrained `n + 1`
// is now correctly rejected under overflow prove-or-reject.)

func add_one(n i32 >= 0 and <= 1000) i32 {
    return n + 1
}

proc main() i32 {
    var small i32 = 100
    var d1 = add_one(small)       // 100 satisfies [0, 1000]; VRA proves 101 fits
    return 0
}
