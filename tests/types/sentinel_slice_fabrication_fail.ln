// EXPECT: [E089]
// A plain (non-terminated) slice cannot be coerced to a sentinel-terminated
// `u8[:0]` — the trailing NUL isn't guaranteed, so a C scanner would overread.
extern func libc_printf(fmt *u8, ...) i32 effects io
func show(msg u8[:0]) effects io { libc_printf("%s\n", msg.data) }
func take(s u8[]) effects io { show(s) }
func main() i32 effects io { return 0 }
