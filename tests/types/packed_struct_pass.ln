// Sprint 19: [packed] struct with bit-exact layout.
// `GpioModer` packs 4 × 2-bit fields into a single uint8_t — asserted below, and checked by the C
// compiler every build. (Until DECIDE-N it was an ordinary 4-byte struct and nothing said so.)

[packed]
type GpioModer {
    pin0 u2
    pin1 u2
    pin2 u2
    pin3 u2
}
assert @sizeof(GpioModer) == 1

func main() i32 {
    var r = GpioModer(1, 2, 3, 0)
    // Read pin1: should be 2.
    var p1 = r.pin1
    return 0
}
