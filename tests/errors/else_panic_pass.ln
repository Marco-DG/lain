// F3.4: `expr else panic(...)` is the one sanctioned bridge from a recoverable
// value error to the unrecoverable abort channel. Aborts on a marker.
extern func libc_printf(fmt *u8, ...) i32 effects io
func open_it(p *u8, fail bool) *u8 | NotFound | Denied {
    if fail { return NotFound }
    return p
}
func main() i32 effects io, raises {
    z = open_it("z", false) else panic("must exist")
    libc_printf("%s\n", z)
    return 0
}
