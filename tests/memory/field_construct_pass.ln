// The field refinements are load-bearing: `p.x + p.y` on an unrefined `Point` is a real
// overflow at INT32_MAX and does not compile. This test's subject is field construction, field by field,
// so the arithmetic is bounded and the subject is kept.
// Partial construction: fill fields one at a time, then use — all sound.
type Point {
    x i32 >= 0 and <= 1000
    y i32 >= 0 and <= 1000
}
func sum(p Point) i32 { return p.x + p.y }
func main() i32 {
    var p Point
    p.x = 5
    p.y = 6
    return sum(p) - 11
}
