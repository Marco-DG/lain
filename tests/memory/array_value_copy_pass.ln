// Whole fixed-array copy has value semantics: `var a = b` and `a = b` both COPY
// (C forbids array `=`, so this must lower to memcpy, not broken C). Verifies the
// copy is independent (mutating the source afterwards does not touch the dest).
proc main() i32 {
    var b i32[4] = [5, 6, 7, 8]
    var a i32[4] = b        // copy-init
    b[2] = 100              // must NOT affect a
    var c i32[4] = [0, 0, 0, 0]
    c = a                   // copy-assign
    return c[2] + a[2]      // 7 + 7 = 14
}
