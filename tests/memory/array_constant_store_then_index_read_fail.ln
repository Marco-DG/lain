// EXPECT: [E019]
// EXPECT-TEXT: Error Ln 9,
// The other half of the same hole: a read at an index the analysis cannot name was accepted
// as soon as ANY element was written. c[0] is written, `c[n]` with n = 3 reads c[3], which
// nothing wrote. Some elements are set and not all, so this is E019 (partially initialised).
func pick(n usize < 4) i32 {
    var c i32[4]
    c[0] = 7
    if c[n] == 7 {
        return 1
    }
    return 0
}

func main() i32 {
    return pick(3)
}
