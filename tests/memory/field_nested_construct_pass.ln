// The field refinements are load-bearing: `p.x + p.y` on an unrefined `Point` is a real
// overflow at INT32_MAX and does not compile. This test's subject is field nested construction,
// so the arithmetic is bounded and the subject is kept.
// Nested construction: fill every leaf (incl. a whole-sub-object write), then use.
type Inner {
    x i32 >= 0 and <= 1000
    y i32 >= 0 and <= 1000
}
type Outer {
    a Inner
    b i32 >= 0 and <= 1000
}
func rd(p Outer) i32 { return p.a.x + p.a.y + p.b }
func main() i32 {
    var p Outer
    var i Inner
    i.x = 1
    i.y = 2
    p.a = i
    p.b = 3
    return rd(p) - 6
}
