// An array whose EVERY element is written is readable at any index, however it was filled:
// four stores at constant indices, or a `for` over 0..len (its lowering states the whole
// initialisation). The regression side of array_index_store_then_constant_read_fail.ln and
// array_constant_store_then_index_read_fail.ln: refusing a symbolic store's credit, and a
// symbolic read of a partly written array, must not refuse these.
func by_stores(n usize < 4) i32 {
    var c i32[4]
    c[0] = 1
    c[1] = 2
    c[2] = 3
    c[3] = 4
    return c[n]
}

func by_loop(n usize < 4) i32 {
    var c i32[4]
    for k in 0..4 {
        c[k] = 5
    }
    return c[n]
}

func main() i32 {
    if by_stores(2) != 3 { return 1 }
    if by_loop(3) != 5 { return 2 }
    return 0
}
