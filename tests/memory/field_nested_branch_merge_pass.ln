// The field refinements are load-bearing: `p.x + p.y` on an unrefined `Point` is a real
// overflow at INT32_MAX and does not compile. This test's subject is field initialisation through a nested branch merge,
// so the arithmetic is bounded and the subject is kept.
// A nested leaf written on both branches is initialized after the join.
type Inner {
    x i32 >= 0 and <= 1000
    y i32 >= 0 and <= 1000
}
type Outer {
    a Inner
    b i32 >= 0 and <= 1000
}
func rd(p Outer) i32 { return p.a.x + p.b }
proc main() i32 {
    var p Outer
    p.a.y = 0
    p.b = 0
    if p.b > 0 {
        p.a.x = 1
    } else {
        p.a.x = 0
    }
    return rd(p)
}
