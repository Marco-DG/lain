// EXPECT: [E010]
// E010, a reference outliving its storage: a pointer variable assigned twice, once to a local element. It compiled, and main read a
// dead frame (ASan stack-use-after-return; `lain --interpret` "no longer live").
func mk(k u32 <= 100, c bool) *u32 {
    xs u32[3] = [k, k + 1, k + 2]
    ys u32[3] = [k, k, k]
    var p = &ys[0]
    if c {
        p = &xs[2]
    }
    return p
}
func clobber(k u32) u32 {
    ys u32[8] = [k, k, k, k, k, k, k, k]
    return ys[3]
}
func main() i32 {
    r = mk(10, true)
    c = clobber(77)
    unsafe {
        if *r != 12 { return 1 }
    }
    return 0
}
