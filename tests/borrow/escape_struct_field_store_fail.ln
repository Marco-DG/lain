// EXPECT: [E010]
// E010, a reference outliving its storage: ...whose slice field is ASSIGNED a slice of a local after construction. It compiled, and main read a
// dead frame (ASan stack-use-after-return; `lain --interpret` "no longer live").
type St {
    a u8
    s u32[]
}
func mk(k u32 <= 100, a u32[]) St {
    xs u32[3] = [k, k + 1, k + 2]
    var s = St(1, a)
    s.s = xs[0..3]
    return s
}
func clobber(k u32) u32 {
    ys u32[8] = [k, k, k, k, k, k, k, k]
    return ys[3]
}
func main() i32 {
    zs u32[1] = [0]
    r = mk(10, zs[0..1])
    c = clobber(77)
    t = r.s
    if t.len < 3 { return 3 }
    if t[2] != 12 { return 1 }
    return 0
}
