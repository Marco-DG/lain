// EXPECT: [E010]
// E010, a reference outliving its storage: ...held by value in another struct. It compiled, and main read a
// dead frame (ASan stack-use-after-return; `lain --interpret` "no longer live").
type St {
    a u8
    s u32[]
}
type Outer {
    x u8
    inner St
}
func mk(k u32 <= 100) Outer {
    xs u32[3] = [k, k + 1, k + 2]
    return Outer(1, St(1, xs[0..3]))
}
func clobber(k u32) u32 {
    ys u32[8] = [k, k, k, k, k, k, k, k]
    return ys[3]
}
func main() i32 {
    r = mk(10)
    c = clobber(77)
    t = r.inner.s
    if t.len < 3 { return 3 }
    if t[2] != 12 { return 1 }
    return 0
}
