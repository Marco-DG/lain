// The running total is over the elements of an UNBOUNDED slice, so it is a real overflow:
// the diagnostic asks for a bound on the count, the element or the total and this has none.
// The subject is the `i in data` bounds proof, so the addition is explicitly wrapping.
func total(data i32[]) i32 effects diverge {
    var s i32 = 0
    var i usize = 0
    while i in data {
        s = s +% data[i]
        i = i + 1
    }
    return s
}
func main() i32 effects diverge {
    var a i32[4] = [10, 20, 30, 40]
    if total(a) == 100 {
        return 0
    }
    return 1
}
