// `assert(pred)` is a CHECKED OBLIGATION: the engine must prove it, and a proven one has no
// runtime cost (prove-or-reject, like every other obligation in this language).
proc probe(i usize, a i32[16]) i32 {
    if i < 16 {
        assert(i < 16)
        return a[i]
    }
    return 0
}
proc main() i32 { return 0 }
