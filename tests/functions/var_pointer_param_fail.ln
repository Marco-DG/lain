// EXPECT: [E100]
// EXPECT-TEXT: Error Ln 8, Col 14: a `var` parameter of pointer type would pass the pointer variable itself by reference, which Lain does not do yet: write `*var T` for a pointer whose target the callee may write.
// `var` on a pointer parameter or return was silently dropped (I.135). `var x i32` passes the
// caller's variable by reference, but `var p *u8` passed the pointer BY VALUE, so a reassignment of
// p in the callee never reached the caller; the C and --interpret agreed. A pointer passed by
// reference is not in the language yet; the writable pointee is `*var T`.
// This program compiled and returned 1, the old pointer's target, not 2.
func set(var p *u8, q *u8) {
    p = q
}
func main() i32 {
    var a u8 = 1
    var b u8 = 2
    var p *u8 = &a
    set(var p, &b)
    var r i32 = 0
    unsafe { r = *p as i32 }
    return r
}
