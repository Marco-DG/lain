// Test: Recursion allowed in proc, loops allowed in func

func recursive_proc(n i32) effects diverge {
    if n > 0 {
        recursive_proc(n - 1) // OK: proc can recurse
    }
}

func loop_func(n i32) i32 {
    var sum = 0
    for i in 0..n {
        sum = sum +% i // OK: for loop allowed
    }
    return sum
}

func main() i32 effects diverge {
    recursive_proc(5)
    return loop_func(10)
}
