// EXPECT: [E011]
// Recursion in a `func` is permitted only when it is provably total. The measure is
// inferred from a strictly-descending parameter (see recursion_infer_measure_pass),
// but here the self-call passes the SAME argument `n` — nothing descends — so no
// measure can be inferred and the recursion (which plainly does not terminate) is
// rejected.
func spin(n i32) i32 {
    if n <= 1 { return 1 }
    return spin(n)
}

proc main() i32 {
    return spin(5)
}
