// EXPECT: [E122]
// EXPECT-TEXT: Error Ln 11,
// A parameter of a REFINED TYPE (`s Pos`, Pos = `i32 >= 1 and <= 9`) converted to `*func(i32) i32`:
// the structural match compared Pos as its base i32, and the callee assumed s in [1, 9]. The
// parent compiled `g(0)`: SIGFPE natively, --interpret 99. I.187
type Pos = i32 >= 1 and <= 9
func inv(s Pos) i32 {
    return 100 / s
}
func main() i32 {
    var g *func(i32) i32 = inv
    var z i32 = 0
    return g(z)
}
