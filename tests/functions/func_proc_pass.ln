extern func libc_printf(fmt *u8, ...) i32 effects io

// A general add of two unconstrained i32 can overflow, so under overflow
// prove-or-reject it uses the wrapping operator `+%` (modular) to opt in.
func add(a i32, b i32) i32 {
    return a +% b
}

func main() i32 effects io {
    var x = add(10, 20)
    libc_printf("Result: %d\n", x)
    return 0
}
