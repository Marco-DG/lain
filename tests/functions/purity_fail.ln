// EXPECT: [E011]
// A pure `func` must not call a `proc` — that would let it perform side effects.
extern proc libc_printf(fmt *u8, ...) i32

proc side_effect() {
    libc_printf("tick\n")
}

func pure_add(a i32, b i32) i32 {
    side_effect()   // Violation: a pure function calling a procedure
    return a + b
}

proc main() i32 {
    var x = pure_add(10, 20)
    return 0
}
