// EXPECT: [E122]
// A function that does MORE than the arrow admits cannot be assigned to it: `noisy`'s row is
// {io}, the arrow's is ∅, and {io} ⊄ ∅. This is the general row-containment rule; the old
// two-point version of it was "a `proc` cannot be assigned to a `*func`".
extern func libc_puts(s *u8) i32 effects io

func noisy(a i32) i32 effects io {
    libc_puts("x")
    return a
}
func main() i32 effects io {
    var f *func(i32) i32 = noisy
    return 0
}
