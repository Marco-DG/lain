// UFCS is UNIVERSAL — `x.is_even()` on an i32 is `is_even(x)`, exactly as it is on a struct.
// It used to die on a non-struct receiver with a raw internal message and no error code
// ("sema error: unknown struct 'i32'"): the field lookup EXITS when the receiver names no
// struct, so the UFCS fallback below it was unreachable for every primitive.
extern proc libc_printf(fmt *u8, ...) i32
func is_even(n i32) bool { return n % 2 == 0 }
func twice(n i32) i32 { return n *% 2 }
func main() i32 effects io {
    var x = 10
    if x.is_even() {
        libc_printf("%d\n", x.twice())
        return 0
    }
    return 1
}
