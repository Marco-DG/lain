// ASan stack-buffer-overflow natively, --interpret 99. I.187
func last(a u8[>= 4]) u8 {
    return a[3]
}
func main() i32 {
    var g *func(u8[]) u8 = last
    var a u8[2] = [1, 2]
    return g(a[0..2]) as i32
}
