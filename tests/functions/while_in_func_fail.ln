// EXPECT: [E011]
// A `while` in a `func` is allowed when a termination measure can be INFERRED from
// the condition (`while i < n { i = i + 1 }` → measure `n - i`). But here `i` moves
// AWAY from the bound (it decrements), so no measure decreases — the loop does not
// provably terminate and must still be rejected (add `decreasing` or use `proc`).

func loop_forever() i32 {
    var i = 0
    while i < 10 {
        i = i - 1
    }
    return i
}

proc main() i32 {
    return loop_forever()
}
