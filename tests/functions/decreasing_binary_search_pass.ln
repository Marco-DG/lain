// Binary-search-style descent terminates: measure `hi - lo` decreases because
// `hi = mid` / `lo = mid+1` (mid = lo + (hi-lo)/2) each at least halve it. Proven
// by the difference-measure normalizer (substitute mid, linearize to a function of
// M = hi-lo, evaluate at the binding M=1 using the correlated X-X/D range).
extern proc libc_printf(fmt *u8, ...) i32
proc descend(flag bool) i32 {
    var lo usize = 0
    var hi usize = 64
    while lo < hi decreasing hi - lo {
        var mid usize = lo + (hi - lo) / 2
        if flag { lo = mid + 1 } else { hi = mid }
    }
    return lo as i32
}
proc main() i32 {
    libc_printf("%d\n", descend(false))
    return 0
}
