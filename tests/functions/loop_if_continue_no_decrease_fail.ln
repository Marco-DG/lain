// EXPECT: [E011]
// SOUNDNESS: a branch is exempt from decreasing the measure only when it LEAVES the
// loop (break/return). Here the `else` neither decreases `i` nor exits: `x` alternates
// between 0 and 1, never passes 5, and the loop runs forever for every n > 0.
func f(n i32) i32 {
    var i = 0
    var x = 0
    while i < n {
        if x > 5 {
            i = i + 1
        } else {
            x = 1 - x
        }
    }
    return i
}
func main() i32 effects diverge { return f(10) }
