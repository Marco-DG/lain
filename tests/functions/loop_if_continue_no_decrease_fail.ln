// EXPECT: [E011]
// SOUNDNESS: a branch is exempt from decreasing the measure only when it LEAVES the
// loop (break/return). Here the `else` neither decreases `i` nor exits — it continues
// the loop while bumping an unrelated `x`, so the measure `n - i` is not guaranteed to
// fall each iteration and the loop is not provably terminating.
func f(n i32) i32 {
    var i = 0
    var x = 0
    while i < n {
        if x > 5 {
            i = i + 1
        } else {
            x = x + 1
        }
    }
    return i
}
proc main() i32 { return f(10) }
