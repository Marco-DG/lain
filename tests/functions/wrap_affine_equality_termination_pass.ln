// An affine equality under wrapping arithmetic (MenloPark, PE.11's wrap leg): 2*y - z = 199 holds on
// every trip where `y -% z` stays in range, and the equality keeps it there (y is 99 or 100, z is 1
// or -1), so x falls by at least 99 a trip under `-%` as it does under `-`.
func menlo(x0 i32) i32 {
    var x i32 = x0
    var y i32 = 100
    var z i32 = 1
    while x >= 0 {
        x = x -% y
        y = y -% z
        z = 0 -% z
    }
    return x
}
func main() i32 {
    return menlo(1000) +% 95
}
