// EXPECT: [E122]
// EXPECT-TEXT: Error Ln 11,
// A pointer whose parameter states Pos into one whose parameter is a plain i32: `h(0)` then reaches
// `inv`, which assumes s in [1, 9]. The parent compiled it. I.187
type Pos = i32 >= 1 and <= 9
func inv(s Pos) i32 {
    return 100 / s
}
func main() i32 {
    var g *func(Pos) i32 = inv
    var h *func(i32) i32 = g
    return h(0)
}
