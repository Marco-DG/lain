// A loop guard over checked arithmetic, as code that keeps its sums in range writes it: each `+?` or
// `-?` is computed into a temporary and read back before it is compared, and the guard's facts must
// still reach the loop's ranking. x + y falls by one a trip (x first, then y) and stays above 0.
func drain(x0 i32, y0 i32) i32 effects raises {
    var x = x0
    var y = y0
    while ((x >= 0 and y < (2147483647 -? x else panic("overflow"))) or (x < 0 and y > (-2147483648 -? x else panic("overflow")))) and (x +? y else panic("overflow")) > 0 {
        if x > 0 {
            x = x - 1
        } else if y > 0 {
            y = y - 1
        }
    }
    return x
}

func main() i32 effects raises {
    if drain(3, 4) != 0 { return 1 }
    return 0
}
