// EXPECT: [E011]
// find_back may answer below `from` before the end (one byte back), so `at = k + 1` can give `at`
// again and count_back's loop need not end: no claim may say a result below hay.len is at least from.
func find_back(hay u8[], b u8, from usize) usize {
    if from > 0 and from < hay.len and hay[from] != b { return from - 1 }
    if from < hay.len { return from }
    return hay.len
}

func count_back(hay u8[], b u8) usize {
    var n usize = 0
    var at usize = 0
    while at < hay.len {
        var k = find_back(hay, b, at)
        if k >= hay.len { break }
        n = n +% 1
        at = k + 1
    }
    return n
}

func main() i32 {
    var s = "ab"
    if count_back(s[0..s.len], 98) > 9 { return 1 }
    return 0
}
