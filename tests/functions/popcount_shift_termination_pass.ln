// Termination: `v = v >> C` (C>=1) is v / 2^C, strictly decreasing an unsigned v>=1.
// The canonical bit-iteration loop (popcount / binary digits) proves total, so it is
// valid in a pure `func`.
func popcount(x0 u32) u32 {
    var x u32 = x0
    var count u32 = 0
    while x > 0 decreasing x {
        count = count +% (x & 1)
        x = x >> 1
    }
    return count
}
func main() i32 {
    var n = popcount(255)
    if n != 8 { return 1 }
    return 0
}
