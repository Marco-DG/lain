// EXPECT: [E011]
// The falling twin of wrapping_step_termination_fail: `i -% 1` at 0 wraps to 255, and `i >= 0`
// holds for every u8, so this never ends. It was proven terminating.
func spin(n u8) i32 {
    var i u8 = n
    while i >= 0 {
        i = i -% 1
    }
    return 0
}
func main() i32 {
    return spin(10)
}
