// EXPECT: [E011]
// Reset through a `var` argument naming the field itself.
type Lexer {
    src u8[]
    pos usize
}
func reset(l var Lexer) { l.pos = 0 }
func zero(x var usize) { x = 0 }
func main() i32 {
    var buf u8[4] = [1, 2, 3, 4]
    var l = Lexer(buf, 0)
    while l.pos < l.src.len {
        l.pos = l.pos + 1
        zero(var l.pos)
    }
    return 0
}
