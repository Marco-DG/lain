// A top-level constant may infer its type from the initializer (`NAME = expr`),
// like an in-function immutable binding — not only `NAME TYPE = expr`.
extern proc libc_printf(fmt *u8, ...) i32
MAX = 100
MIN = 5
STEP = MAX / MIN
func main() i32 effects io {
    libc_printf("%d\n", MAX - MIN + STEP)
    return 0
}
