// A top-level constant of a slice type (`u8[:0] = "…"`) must compile: its
// Slice_<T> typedef has to be emitted BEFORE the constant, and the string literal
// lowered to a {.data,.len} slice initializer (not `= "…"` onto a struct).
extern proc libc_printf(fmt *u8, ...) i32
GREETING u8[:0] = "hello"
NAME u8[:0] = "world"
func main() i32 effects io {
    libc_printf("%d %d\n", GREETING.len as i32, NAME.len as i32)
    return 0
}
