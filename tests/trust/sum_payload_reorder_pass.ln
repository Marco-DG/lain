// DECIDE-U for sums: a tagged sum's payload is stored like a struct, its fields by decreasing
// alignment, and every construction, `case` and copy must still find each field by name. The
// sizes are checked in main, so they hold in the C (run here) and under `lain --interpret`
// (interp_gate): the payload was emitted in declaration order while the interpreter's size model
// reordered it, and `@sizeof(Sh)` was 32 in the C and 24 interpreted. [ordered] and a sum an
// extern's signature reaches keep the declaration, 32 bytes.
type Sh {
    Wide { a u8, b i64, c u8 }
    Mid { x u16, y u32, z u8 }
    Flat
}
[ordered]
type Wire {
    Rec { a u8, b i64, c u8 }
    Empty
}
type ExtSum {
    V { a u8, b i64, c u8 }
    N
}
extern func takes_ext(e *ExtSum) i64 effects
type Two(T type) {
    Pair { flag u8, v T }
    Zero
}
func wide(s Sh) i64 {
    case s {
        Wide(a, b, c):
            if a != 1 or b != -5000000000 or c != 3 { return 1 }
            return 0
        Mid(x, y, z):
            if x != 600 or y != 70000 or z != 9 { return 2 }
            return 0
        Flat: return 0
    }
}
func pass(s Sh) Sh { return s }
func main() i32 {
    if @sizeof(Sh) != 24 { return 10 }
    if @sizeof(Wire) != 32 { return 11 }
    if @sizeof(ExtSum) != 32 { return 12 }
    if @sizeof(Two(u64)) != 24 { return 13 }
    if wide(Sh.Wide(1, -5000000000, 3)) != 0 { return 1 }
    if wide(pass(Sh.Mid(600, 70000, 9))) != 0 { return 2 }
    if wide(Sh.Flat) != 0 { return 3 }
    w = Wire.Rec(7, 8, 9)
    case w {
        Rec(a, b, c):
            if a != 7 or b != 8 or c != 9 { return 4 }
        Empty: return 5
    }
    t = Two(u64).Pair(2, 123456789012)
    case t {
        Pair(f, v):
            if f != 2 or v != 123456789012 { return 6 }
        Zero: return 7
    }
    return 0
}
