// `+| -| *|` and `+? -? *?` at the widths their widen-to-i64 expansion cannot serve. Until
// 2026-09-28 widths 33..63 were E100 ("unhandled-binop"), checked operators stopped at 32 bits,
// and a u32 multiply computed its product in the SIGNED i64, where 4294967295 * 4294967294 is a
// C signed overflow. They now share the guarded expansion 64 bits already used: the overflow
// test first, then the operation, which the test has proven cannot overflow.
func c1() bool {
    var a u32 = 4294967295
    var b u32 = 4294967294
    var r = a *| b
    return r == 4294967295
}
func c2() bool {
    var a u32 = 4294967295
    var b u32 = 4294967294
    var r = a *? b else 7
    return r == 7
}
