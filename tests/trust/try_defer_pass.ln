// TRUST: try propagates a marker; the defer on the early-return (error) path must
// run exactly once and stay memory-safe under ASan.
extern proc libc_printf(fmt *u8, ...) i32
func step(p *u8, fail bool) *u8 | Err {
    if fail { return Err }
    return p
}
proc work(p *u8, fail bool) *u8 | Err {
    defer libc_printf("cleanup\n")
    v = try step(p, fail)
    libc_printf("past\n")
    return v
}
proc main() i32 {
    var r *u8 | Err = work("x", true)
    case r {
        Err:  libc_printf("got Err\n")
        else: libc_printf("val\n")
    }
    return 0
}
