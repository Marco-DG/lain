// The allowed side of I.83: a plain character, the escapes, and a hexadecimal escape each hold one
// value, and keep it. Run under the sanitizers and the interpreter.
func main() i32 {
    a = 'a'
    nl = '\n'
    hx = '\x41'
    q = '\''
    z = '\0'
    if a != 97 or nl != 10 or hx != 65 or q != 39 or z != 0 {
        return 1
    }
    return 0
}
