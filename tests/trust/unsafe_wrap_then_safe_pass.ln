// A narrowing that `unsafe` waives WRAPS (spec 18: the block inherits C17's conversion), and the
// analysis now reads it that way: an exact value wraps to an exact value, so the SAFE code after
// each block is proven against what the machine holds. Before, every index below was refused
// (the analysis believed 260, 260, 263, 261 and 262). Run under the sanitizers and the
// interpreter, which must waive the narrowing INSIDE the block (a `return` included) and check
// the proofs after it.
type S { v u8, w u8 }

func add(p u8, q u8) u8 {
    unsafe {
        return p + q
    }
}

func narrow(y u16) u8 {
    var x u8 = 0
    unsafe {
        x = y as u8
    }
    return x
}

func main() i32 {
    var a i32[8] = [1, 2, 3, 4, 5, 6, 7, 8]
    var y u16 = 260
    var x u8 = 0
    unsafe {
        x = y as u8
    }
    var p u8 = 200
    var q u8 = 60
    var z u8 = 0
    unsafe {
        z = p + q
    }
    var w u16 = 263
    var s = S(0, 0)
    unsafe {
        s.v = w as u8
    }
    v = add(200, 61)
    u = narrow(262)
    t = a[x] + a[z] + a[s.v] + a[v] + a[u]
    if t != 31 {
        return 1
    }
    return 0
}
