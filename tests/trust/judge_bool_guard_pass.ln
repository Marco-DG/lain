// The proof engine's judge states a BOOL condition as a fact, as it does a comparison: where a
// branch on `b` took its first edge, b = 1, and b = 0 on the other (a bool is 0 or 1, and a branch
// takes its first target on nonzero). So `assert(b)` under `if b` is implied, and so is
// `assert(ok)` under `if ok` for a bool held in a cell (the cell's version is the condition), and
// `assert(b)` and `assert(c)` under `if b and c`. Only comparisons were facts before, and these
// four were not implied. judge_gate requires every VC of this program implied, with and without
// the finder. The results are read natively and with --interpret.
func ready(x u32) bool { return x > 3 }
func f(b bool) i32 {
    if b {
        assert(b)
        return 1
    }
    return 0
}
func g(x u32) i32 {
    var ok = ready(x)
    if ok {
        assert(ok)
        return 2
    }
    return 0
}
func h(b bool, c bool) i32 {
    var n i32 = 0
    if b and c {
        assert(b)
        assert(c)
        n = 3
    }
    return n
}
func main() i32 {
    if f(true) != 1 or f(false) != 0 { return 1 }
    if g(5) != 2 or g(1) != 0 { return 2 }
    if h(true, true) != 3 or h(true, false) != 0 { return 3 }
    return 0
}
