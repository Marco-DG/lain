// A `var` declared inside a block (an `if` or `while` body) may be written like any `var`: its
// elements, its fields, through a reference binding, lent `var`, or passed to an output
// parameter. Since 50b804b all of these were E009 "an immutable binding": the check re-looked
// the name up after the block's scope was gone, and an unknown name read as immutable. The
// resolver now records each local's writability where the name meets its binding.
type P {
    x i32
    y i32
}
func set0(d i32[3], v i32) {
    d[0] = v
}
func bump(n var i32) {
    n = n +% 1
}
func f(c bool) i32 {
    var t i32 = 0
    if c {
        var a i32[2] = [1, 2]
        a[0] = 5
        var p = P(1, 2)
        p.x = 6
        var q = var p
        q.y = 7
        var arr i32[3] = [0, 0, 0]
        set0(arr, 8)
        var n i32 = 1
        bump(var n)
        t = a[0] +% p.x +% p.y +% arr[0] +% n
    }
    var i = 0
    while i < 1 {
        var w i32[1] = [0]
        w[0] = 3
        t = t +% w[0]
        i = i + 1
    }
    return t
}
func main() i32 {
    if f(true) != 31 { return 1 }
    if f(false) != 3 { return 2 }
    return 0
}
