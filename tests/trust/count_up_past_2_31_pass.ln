// Count-up loops whose bound is a constant past 2^31. The bound reaches the finder's paths as the
// constant's definition (`v = 2147483649`), beside the test `i - v <= -1`, and `2147483648 - i`
// ranks the first loop. Before, the finder dropped every hypothesis with a constant past 2^31, as it
// drops a type's bounds, and kept the test without what v is: no ranking existed, and E011 (TCW,
// 2026-10-25: 2^31 accepted, 2^31 + 1 refused, over an i64). Few laps each, so the test runs.
extern func libc_printf(fmt *u8, ...) i32 effects io

func main() i32 effects io {
    var i i64 = 2147483000
    while i < 2147483649 {
        i = i + 1
    }
    var j i64 = 0
    while j < 30000000000 {
        j = j + 1000000
    }
    var k u64 = 0
    while k < 4611686018427387904 {
        k = k + 1000000000000000
    }
    libc_printf("%lld %lld\n", i, j)
    return 0
}
