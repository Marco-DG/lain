// I.204: a vector operation takes its signedness from the LANES. `a >> b` on i8 lanes by a u32
// amount took the amount's: a logical shift in the IR, so VRA and the interpreter read -128 >> 5
// as 4 while the C, an arithmetic shift on a signed vector, gave -4: a non-negative fact about a
// lane that is negative natively. And a scalar beside a vector lands in the lane type, checked:
// here d, a u32 proven to fit an i32 lane. Native at -O0 and -O2 and --interpret agree.
extern func libc_printf(fmt *u8, ...) i32 effects io
func sar(a i8x4, b u32 <= 7) i8x4 {
    return a >> b
}
func sar16(a i16x8, b u32 <= 15) i16x8 {
    return a >> b
}
func addu(a i32x4, d u32 <= 100) i32x4 {
    return a + d
}
func divu(a i32x4, d u32 >= 1 and <= 100) i32x4 {
    return a / d
}
func main() i32 effects io {
    var a i8x4 = [-128, -1, 127, -7]
    r = sar(a, 5)
    libc_printf("%d %d %d %d\n", r[0] as i32, r[1] as i32, r[2] as i32, r[3] as i32)
    var h i16x8 = [-32768, -2, 2, 32767, -100, 100, -1, 0]
    s = sar16(h, 3)
    libc_printf("%d %d %d %d %d %d %d %d\n", s[0] as i32, s[1] as i32, s[2] as i32, s[3] as i32, s[4] as i32, s[5] as i32, s[6] as i32, s[7] as i32)
    var w i32x4 = [-100, 100, 7, -7]
    p = addu(w, 99)
    q = divu(w, 3)
    libc_printf("%d %d %d %d / %d %d %d %d\n", p[0], p[1], p[2], p[3], q[0], q[1], q[2], q[3])
    return 0
}
