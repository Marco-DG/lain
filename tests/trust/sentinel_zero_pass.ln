// 0 is the only sentinel, spelled `0` (spec 07), and the allowed side of refusing every other
// spelling: a string literal passed as `u8[:0]`, and a `u8[:0]` passed on where `u8[:0]` is
// expected. The C ends a literal with the NUL it writes, which is what the type promises.

func count(s u8[:0]) usize {
    return s.len
}

func relay(s u8[:0]) usize {
    return count(s)
}

func main() i32 {
    if count("hello") != 5 {
        return 1
    }
    if relay("hi") != 2 {
        return 2
    }
    s u8[:0] = "abc"
    if relay(s) != 3 {
        return 3
    }
    return 0
}
