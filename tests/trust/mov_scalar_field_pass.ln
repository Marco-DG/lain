// I.82, the allowed side: a `mov` int field consumed on every path compiles and runs. An owned binding
// of a struct with no `mov` field (`mov k Counter`) owns no resource and needs no consumer (I.93 keeps
// that case apart). A plain parameter `n i32` is not `mov`: since I.92 a `mov` scalar must be released,
// and a body that only returns it is the identity route plan I.95 asks about, so this test does not
// use one. Run under the sanitizers and the interpreter.
extern func libc_printf(fmt *u8, ...) i32 effects io

type Fd { mov fd i32 }
type Counter { value i32 }

func close_fd(mov {fd} Fd) effects io {
    libc_printf("closed\n")
}

func use_fd(c bool) i32 effects io {
    f = Fd(4)
    if c {
        close_fd(mov f)
        return 1
    }
    close_fd(mov f)
    return 0
}

func plain(n i32, mov k Counter) i32 {
    return n +% k.value
}

func main() i32 effects io {
    a = use_fd(true)
    b = use_fd(false)
    libc_printf("%d %d %d\n", a, b, plain(2, Counter(3)))
    return 0
}
