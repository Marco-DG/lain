// I.79 (DECIDE-X): `x in [a, b, c]` is membership in a list of constants. Until I.75 the same spelling
// meant `x < 3`, the list's LENGTH, so `member(3)` was 0 and `member(2)` was 1 (Handwriting); then it
// was refused; now it means what it reads as. Characters, negative elements, a u64 against small
// constants, elements folded from arithmetic (`0 - 3`, `'a' + 1`), the value and the branch form, and
// an index proven from the list's hull (`t[i]` after `i in [0, 2]`). Run under the sanitizers and the
// interpreter; expected output from Python.
extern func libc_printf(fmt *u8, ...) i32 effects io

func member(x i32) i32 {
    if x in [1, 3, 5] {
        return 1
    }
    return 0
}

func is_ws(c u8) bool {
    return c in [' ', 9, 10, 13]
}

func pick(t u8[3], i usize) u8 {
    if i in [0, 2] {
        return t[i]
    }
    return 0
}

func sign(x i32) i32 {
    if x in [-1, 0, 1] {
        return 1
    }
    return 0
}

func folded(x i32) i32 {
    if x in [0 - 3, 'a' + 1] {
        return 1
    }
    return 0
}

func wide(x u64) i32 {
    if x in [7] {
        return 1
    }
    return 0
}

func main() i32 effects io {
    t u8[3] = [5, 6, 7]
    var big u64 = 0
    big = big -% 1
    libc_printf("%d%d%d%d\n", member(1), member(2), member(3), member(5))
    libc_printf("%d%d%d%d %d%d%d\n", is_ws(32) as i32, is_ws(9) as i32, is_ws(13) as i32, is_ws(65) as i32, pick(t, 0) as i32, pick(t, 1) as i32, pick(t, 2) as i32)
    libc_printf("%d%d%d %d%d %d%d%d\n", sign(0 - 1), sign(1), sign(2), wide(7), wide(big), folded(0 - 3), folded(98), folded(97))
    return 0
}
