// I.172: an instance's name joins its arguments with `_`, and a name may hold one, so
// `Pair(My, Type_X)` and `Pair(My_Type, X)` are both `Pair_My_Type_X`. The second was the first's
// instance (its `r.c` read as X's u8 where Type_X's is an i64), and the program compiled (chain 4
// refused it, a stopgap). Found by template and arguments now, the second is a new instance under
// the first free name, `Pair_My_Type_X_2`. Both are built and read. E124 on the parent.
type My_Type {
    a i32
}
type My {
    a i32
}
type X {
    c u8
}
type Type_X {
    c i64
}
type Pair(A type, B type) {
    l A
    r B
}
func one(p Pair(My_Type, X)) u8 {
    if p.l.a != 1 { return 0 }
    return p.r.c
}
func two(p Pair(My, Type_X)) i64 {
    return p.r.c
}
func main() i32 {
    var p = Pair(My_Type(1), X(7))
    var q = Pair(My(2), Type_X(5000000000))
    if one(p) != 7 { return 1 }
    if two(q) != 5000000000 { return 2 }
    return 0
}
