// A shift amount proven in [0, width-1] by a guard is accepted (check-free). Uses
// an UNSIGNED operand and the WRAPPING shift `<<%`, where an in-range amount fully defines
// the shift: the bits shifted out are discarded, which is what `<<%` says. (A plain `<<` may
// not lose bits, signed or unsigned; that is a value question handled like `*` overflow, not
// by the amount check: shift_range_exceeds_fail.ln.)
func f(x u32, n u32) u32 {
    if n < 32 {
        return x <<% n
    }
    return 0
}
func main() i32 { return 0 }
