// EXPECT: [E086]
// The twin of judge_stored_cmp_pass.ln: ok holds y <= 2147483646 for the y it compared, and y is
// written after it, so under `if ok` the y read is b0, any i32, and y + 1 may be 2^31: E086 stands.
// A comparison's value is a fact about the values it compared, not about the cell they came from.
func f(a0 i32, b0 i32) i32 {
    var y = a0
    ok = y <= 2147483646
    y = b0
    if ok { return y + 1 }
    return 0
}
func main() i32 { return f(1, 2) }
