// The proof engine's judge states a value made on ONE path into a join only inside that path's
// disjunct: on another path the value is stale. `i >= a.len` with a signed `i` lowers to two arms,
// and only one of them computes `(u64)i`. Each trip of this loop reaches the join after the
// `if`, the second trip through the arm that does not compute it, with the first trip's value
// still in the frame; judge_gate.sh evaluates the join's facts there. Without this program, a
// generator that stated the arm's value for every path went unseen. The sum is read natively and
// with --interpret.
func count(a i32[], xs i32[]) i32 {
    var s i32 = 0
    var j usize = 0
    while j < xs.len {
        i = xs[j]
        var k i32 = 0
        if i >= a.len { k = 1 }
        s = s +% 100 / (k + 1)
        j = j + 1
    }
    return s
}

func main() i32 {
    var a i32[4] = [1, 2, 3, 4]
    var xs i32[3] = [5, -1, 2]
    if count(a[0..4], xs[0..3]) != 250 { return 1 }
    return 0
}
