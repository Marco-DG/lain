// The proof engine's judge needs CALLEE CONTRACTS here: claims about what a function returns, each
// owed at every return (`post`) and stated at every call in the same module (I.181's boundary),
// the call's result for the returned value and each argument for its parameter. `t[mn(i, 7)]`
// needs `mn(a, b) <= b`, a claim that names a parameter (its entry value); `t[clamp7(x)]` needs
// the returns' hull, [0, 7]; `100 / nonzero(d)` needs `nonzero(d) >= 1`; `larger(x, 0) as u32`
// needs `larger(a, b) >= b`; `t[sub_sat(7, i)]` needs `sub_sat(a, b) <= a`, of a callee whose
// parameters do not commute (an argument read for the other parameter is false there);
// `t[upto(7)]` needs `upto(n) <= n`, which rests on upto's own loop invariant `i <= n`; `t[k]`
// needs the caller's loop invariant `k <= 7`, which rests on `next(k) <= 7`. judge_gate requires
// every VC of this program implied, from the judge's OWN candidates (the returns' hull and the
// templates `ret - p`, `ret + p` per integer parameter: `--no-finder`) as well as with VRA's
// return intervals, and checks each claim at every return the program makes and at every call
// that uses it. The result is read natively and with --interpret.
func mn(a u32, b u32) u32 {
    if a < b { return a }
    return b
}
func clamp7(x i32) i32 {
    if x < 0 { return 0 }
    if x > 7 { return 7 }
    return x
}
func nonzero(d u32) u32 {
    if d == 0 { return 1 }
    return d
}
func larger(a i32, b i32) i32 {
    if a > b { return a }
    return b
}
func sub_sat(a u32, b u32) u32 {
    if a > b { return a - b }
    return 0
}
func upto(n u32) u32 {
    var i u32 = 0
    while i < n decreasing n - i { i = i + 1 }
    return i
}
func next(k u32) u32 {
    if k < 7 { return k + 1 }
    return 7
}
func main() i32 {
    var t u8[8] = [1, 2, 3, 4, 5, 6, 7, 8]
    var s u32 = 0
    var i u32 = 0
    var k u32 = 0
    while i < 20 decreasing 20 - i {
        s = s +% t[mn(i, 7)]
        s = s +% t[clamp7(i as i32 - 6)]
        s = s +% 100 / nonzero(i % 3)
        s = s +% larger(i as i32 - 9, 0) as u32
        s = s +% t[sub_sat(7, i)]
        s = s +% t[k]
        k = next(k)
        i = i + 1
    }
    s = s +% t[upto(7)]
    if s != 2165 { return 1 }
    return 0
}
