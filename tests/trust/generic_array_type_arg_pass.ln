// An array type is a type argument: `G(u8[4])`, or an alias of one, `G(Quad)`. Both were E124
// ("expects a type argument"): an argument written `u8[4]` parses as an index into the type, and
// an alias of an array was not read as the type it names. They are ONE instance, the one a
// parameter type `G(Quad)` names, so `get` takes either. The array's length is part of the
// instance's name: `G(u8[4])` and `G(u8[8])` were both `G_arr_u8`, two instances on one name.
type Quad = u8[4]
type G(T type) {
    Has { v T }
    No
}
func get(g G(Quad)) u8 {
    case g {
        Has(v): return v[3]
        No: return 0
    }
}
func main() i32 {
    xs Quad = [1, 2, 3, 4]
    a = G(Quad).Has(xs)
    zs u8[4] = [5, 6, 7, 8]
    b = G(u8[4]).Has(zs)
    if get(a) != 4 or get(b) != 8 { return 1 }
    ys u8[8] = [9, 9, 9, 9, 9, 9, 9, 7]
    c = G(u8[8]).Has(ys)
    case c {
        Has(v): if v[7] != 7 { return 2 }
        No: return 3
    }
    return 0
}
