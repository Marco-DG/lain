// `.len` is an unbounded `usize`, so `data.len as i32` is a real narrowing and `as` is the
// PROVEN tier — it compiles only where the value is shown to fit. The guard is what shows
// it, and it costs one comparison on a path that never runs for a string literal. The
// subject is `.len` on a sentinel slice, which the guard leaves intact.
extern proc libc_printf(fmt *u8, ...) i32
func count(data u8[:0]) i32 {
    if data.len < 2147483647 {
        return data.len as i32
    }
    return -1
}
proc main() i32 {
    libc_printf("%d\n", count("hello"))
    return 0
}
