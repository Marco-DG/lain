extern func libc_printf(fmt *u8, ...) i32 effects io
func lookup(p *u8, k i32) *u8 | NotFound | Denied {
    if k == 1 { return NotFound }
    if k == 2 { return Denied }
    return p
}
func main() i32 effects io {
    var r *u8 | NotFound | Denied = lookup("V", 2)
    case r {
        NotFound: libc_printf("nf\n")
        Denied:   libc_printf("denied\n")
        else:     libc_printf("%s\n", r)
    }
    return 0
}
