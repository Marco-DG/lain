// Module-qualified access: `io.println` resolves the member through the imported
// module `io` (the last segment of `std.io`). The glob still binds `println`
// unqualified too — qualification is additive.
import std.io.{print, println}

func main() i32 effects io {
    io.println("hi")
    println("also unqualified")
    return 0
}
