// EXPECT: [E011]
// A pure `func` must not read a mutable global — its result would then depend
// on hidden mutable state (not just its arguments). Was a hole: a top-level
// `var` global was mis-parsed as immutable, so the is_mutable-keyed read guard
// never fired.
var k i32
func pure_read() i32 {
    return k
}
proc main() i32 {
    return 0
}
