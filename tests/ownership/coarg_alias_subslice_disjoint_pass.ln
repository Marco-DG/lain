// Elements of a slice parameter are unbounded, so `dst[i] + src[i]` is a real overflow and
// prove-or-reject refuses it. This test's subject is disjointness of two sub-slices of the same array, not arithmetic, so the
// addition is explicitly wrapping (`+%`) — which states the intent rather than
// relying on an engine that was not looking.
// Disjoint COMPILE-TIME-CONSTANT sub-slices of one array are NOT aliasing and must
// be accepted — the fix must not reject correct code (design law).
func vadd(n usize, dst i32[n], src i32[n]) {
    var i usize = 0
    while i < n decreasing n - i {
        dst[i] = dst[i] +% src[i]
        i += 1
    }
}
func main() i32 {
    var a i32[8] = [1, 2, 3, 4, 5, 6, 7, 8]
    vadd(4, a[0..4], a[4..8])
    return a[0]
}
