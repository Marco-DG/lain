// Disjoint COMPILE-TIME-CONSTANT sub-slices of one array are NOT aliasing and must
// be accepted — the fix must not reject correct code (design law).
proc vadd(n usize, dst i32[n], src i32[n]) {
    var i usize = 0
    while i < n decreasing n - i {
        dst[i] = dst[i] + src[i]
        i += 1
    }
}
proc main() i32 {
    var a i32[8] = [1, 2, 3, 4, 5, 6, 7, 8]
    vadd(4, a[0..4], a[4..8])
    return a[0]
}
