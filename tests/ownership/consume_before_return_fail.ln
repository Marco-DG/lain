// EXPECT: [E003]
// Lock: an owned linear param must be consumed before return.
// ADJUDICATED 2026-09-08: the type was not linear. spec/chapters/07-types.tex is
// normative — "a struct type is linear if and only if at least one of its fields is of
// a linear type" — and `h i32` is unrestricted, so nothing here had to be consumed. The
// old engine enforced `mov` on the BINDING; the new engine enforces linearity of the
// TYPE, which is what the spec says. The field is now genuinely linear, which restores
// what this test was written to lock. Both engines reject it.

type R {
    mov h *u8
}
proc sink(mov r R) { }
proc main() i32 { return 0 }
