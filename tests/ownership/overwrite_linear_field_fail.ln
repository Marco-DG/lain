// EXPECT: [E021]
// The same one level down: a live linear FIELD overwritten.
type Res { mov h *i32 }
func rfree(mov {h} Res) { }
type Two { mov a Res, mov b Res }
func split(mov {a, b} Two) {
    rfree(mov a)
    rfree(mov b)
}
func main() i32 {
    var n i32 = 0
    var m i32 = 0
    var t = Two(Res(&n), Res(&m))
    t.a = Res(&n)
    split(mov t)
    return 0
}
