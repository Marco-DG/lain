// The supported way to hand a mutable borrow to the code that needs it: pass it at the call,
// where it lives for exactly that call. Storing it in a local is [E126]
// (see direct_var_borrow_fail.ln).

type Data {
    value i32
}

proc set_to(var v i32) {
    v = 43
}

func read_data(d Data) i32 {
    return d.value
}

proc main() i32 {
    var data Data
    data.value = 42
    set_to(var data.value)
    return read_data(data)
}
