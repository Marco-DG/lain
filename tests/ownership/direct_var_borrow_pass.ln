// Two ways to hand a mutable borrow to the code that needs it: pass it at the call, where it
// lives for exactly that call, or bind it (`var r = var data.value`, A.3), where it lives until
// its last use. The owner is untouchable while the binding is live (direct_var_borrow_fail.ln).

type Data {
    value i32
}

func set_to(var v i32) {
    v = 43
}

func read_data(d Data) i32 {
    return d.value
}

func main() i32 {
    var data Data
    data.value = 42
    set_to(var data.value)
    var r = var data.value
    r = r +% 1
    set_to(var r)
    return read_data(data)
}
