// EXPECT: [E004]
// NLL: a borrow used AFTER an access to its owner keeps the loan alive across that access.
// Straight-line code; no loop.
//
// RENAMED 2026-09-15 from `nll_loop_borrow_fail.ln`, which it never was — there is no loop in
// it. The misnomer mattered: it made the corpus look as though the loop case were covered, and
// a genuine loop-back-edge conflict (D-36) went undetected through a 690-program suite. The
// real loop case is now `nll_loop_backedge_fail.ln`.

type Data {
    value i32
}

func get_ref(var d Data) var i32 {
    return var d.value
}

func consume_ref(var r i32) {
    // nothing needed — just keeps ref alive
}

func read_data(d Data) i32 {
    return d.value
}

func main() i32 {
    var data Data
    data.value = 42
    
    // get_ref borrows 'data' mutably → ref holds the borrow alive
    var ref = get_ref(var data)
    
    // This should FAIL: ref is used AFTER this line, so borrow is still active
    var x = read_data(data)
    
    // ref used here — extends the borrow past the read_data call
    consume_ref(var ref)
    
    return x
}
