// EXPECT: [E087]
// A sub-slice of a mutated array, aliasing the same array at another parameter,
// must be rejected: `a[0..4]` lowers to `a+0`, aliasing the `restrict` dst — the
// exact `vadd(a,a)` UB written to dodge the bare-identifier aliasing check.
proc vadd(n usize, dst i32[n], src i32[n]) {
    var i usize = 0
    while i < n decreasing n - i {
        dst[i] = dst[i] + src[i]
        i += 1
    }
}
proc main() i32 {
    var a i32[4] = [1, 2, 3, 4]
    vadd(4, a, a[0..4])
    return a[0]
}
