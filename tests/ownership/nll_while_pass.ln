// ⚠ `effects diverge` — the compiler cannot prove this loop terminates, and says so here
// rather than exempting every `proc` from the question. Before 2026-09-24 the keyword
// `proc` carried this permission silently: it means "may do IO", and every IO function
// inherited "may hang" for sharing it. Measured then: 173 procs did IO and terminated
// while exempt, against 61 that actually diverge. The marker is now on the exceptions.
// Tests that Non-Lexical Lifetimes (NLL) work for temporary borrows in conditions.

type Lexer {
    pos i32
}

func peek(l Lexer) i32 {
    return l.pos
}

func consume(var l Lexer) i32 {
    l.pos = l.pos +% 1
    return l.pos
}

func test_nll_while() effects diverge {
    var l = Lexer(0)
    
    // The peek(l) creates a shared borrow of `l`.
    // In a purely lexical scope, this borrow would live until the end of the while loop,
    // conflicting with the mutable borrow consume(var l) inside the loop body.
    // With NLL, the temporary borrow from peek(l) expires immediately after the condition is evaluated.
    while peek(l) < 10 {
        consume(var l)
    }
}

func main() i32 effects diverge {
    test_nll_while()
    return 0
}
