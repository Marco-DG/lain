// EXPECT: [E005]
// A `var x` mutable borrow is for modifying an ALREADY-initialized value, not
// for filling an empty one: passing an uninitialized `var v` is now rejected.
// To produce a value, construct-and-return it instead (`v = makeit()`).
func setit(x var i32) {
    x = 9
}
func main() i32 {
    var v i32
    setit(var v)
    return v
}
