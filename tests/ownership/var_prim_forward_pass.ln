// var T primitive forwarding — PASS
// A var i32 param forwarded to another var i32 function passes the raw pointer
// (no double-dereference, no double-address-of). n + n wraps (`+%`).

func double_in_place(var n i32) {
    n = n +% n
}

func apply(var x i32) {
    double_in_place(var x)
}

func main() i32 {
    var val i32 = 21
    apply(var val)
    return val
}
