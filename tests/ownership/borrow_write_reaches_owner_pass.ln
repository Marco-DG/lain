// Writing THROUGH a returned mutable borrow must reach the owner. Returns 0 iff it did.
//
// D-38 tier 1, pinned 2026-09-15. This was a live MISCOMPILE, not a latent one: before the
// fix `var r = ref_val(var c)` declared `r` as `int32_t` while the initialiser was an
// `int32_t*`, so the binding held a truncated address and `r = 42` wrote to the integer
// instead of to `c.val`. The program returned 1; it should return 42.
//
// Nothing caught it. gcc reports int-from-pointer as a WARNING, the broken-C gate compiles
// with `-w`, and the seven corpus programs over this construct never READ the binding — so
// the exit-code suite was green on a compiler that could not write through a borrow.
//
// This test reads the value back through the OWNER, so a truncated-address binding fails it.

type Cell {
    val i32
}

func ref_val(var c Cell) var i32 {
    return var c.val
}

proc main() i32 {
    var c Cell
    c.val = 7
    var r = ref_val(var c)
    r = 42
    return c.val - 42
}
