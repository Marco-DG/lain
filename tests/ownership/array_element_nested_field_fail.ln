// EXPECT: [E003]
// ★ THE HOLE THAT THE ELEMENT RULE OPENED, and the reason a flat mask can name ONE level.
//
// `a[0].h1` is a place INSIDE element 0. Resolving it to "element 0" claims the whole element
// was released — so this program, which releases h1 and leaks h2, was ACCEPTED. Fail-OPEN,
// introduced by the same change that made element-wise release work at all (D-31), and found
// by asking what happens when an element has TWO linear fields instead of one.
//
// ★ IT IS STILL REJECTED, AND NOW FOR THE RIGHT REASON. Between then and now the location
// tree landed (plan A.2): `a[0].h1` and `a[0].h2` are separate obligation LEAVES, each with
// its own bit. So the compiler no longer refuses this because it cannot name the place — it
// refuses it because `h2` is genuinely never released.
//
// An earlier version of this comment said the test "should flip to accepted when a tree can
// name the place". That was wrong: the program leaks, and must be refused forever. What the
// tree changed is the DIAGNOSIS, not the verdict — see array_element_nested_field_pass.ln for
// the program this one is one release short of.
type H { mov p *i32 }
type R { mov h1 H, mov h2 H }
func drop_h(mov {p} H) { }
proc main() i32 {
    var q *i32 = 0
    var a R[1] = [R(H(q), H(q))]
    drop_h(mov a[0].h1)
    return 0
}
