// EXPECT: [E016]
// Test: elif chains — FAIL case
// Consuming a linear variable in only some branches must fail

type Resource {
    mov handle i32
}

// the handle is released by its C owner; returning it as a plain i32 would release nothing (E140)
extern func close_handle(h mov i32) effects io

func consume(r mov Resource) effects io {
    close_handle(mov r.handle)
}

func main() effects io {
    var r = Resource(42)
    var x = 0
    if x == 1 {
        consume(mov r)
    } else if x == 2 {
        // missing consume — not consumed in this branch
    } else {
        consume(mov r)
    }
}
