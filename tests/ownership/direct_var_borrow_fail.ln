// EXPECT: [E004]
// A reference binding holds its place for as long as it is USED — the owner may not be written
// underneath it.
//
// This file asserted [E126] from 2026-09-15 to 2026-09-26: a mutable borrow could not be stored
// in a local, because `var ref = var data.value` emitted `int32_t ref = &(data.value);`. DECIDE-G
// (A.3) admitted the binding and gave it the representation D-38 had already given the
// returned-borrow form, so what this file now locks is the rule that stays: exclusivity over the
// binding's live range (NLL). `ref` is used after `data.value = 7`, so that write is a conflict.

type Data {
    value i32
}

func main() i32 {
    var data Data
    data.value = 42
    var ref = var data.value
    data.value = 7
    ref = 1
    return 0
}
