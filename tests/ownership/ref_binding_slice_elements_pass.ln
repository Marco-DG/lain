// ...while writing THROUGH a slice reference binding reaches the slice's elements — the
// operation the borrow exists for.
func main() i32 {
    var big u8[8] = [1, 2, 3, 4, 5, 6, 7, 8]
    var s u8[] = big
    var r = var s
    if r.len > 0 { r[0] = 42 }
    if s.len > 0 {
        if s[0] != 42 { return 1 }
    }
    return 0
}
