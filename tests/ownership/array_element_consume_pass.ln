// ★ D-31 / C2: AN ARRAY OF RESOURCES, RELEASED ONE ELEMENT AT A TIME.
//
// `[T; N]` is linear iff T is, so this array carries TWO release obligations. Discharging
// them is the only correct thing a program can do with it — and until 2026-09-23 the
// compiler refused this program, because an indexed place resolved to "unknown", the consume
// was never recorded, and every element-wise release still looked like a leak.
//
// The plan called this "an array of resources has no correct spelling at all". It was
// over-rejection, not unsoundness — the right direction to fail — but it made the shape
// unusable.
//
// A CONSTANT index names one element as precisely as a field name does, so it now takes a bit
// in the same mask. See array_element_double_consume_fail.ln for the other direction, and
// array_element_variable_index_fail.ln for the case that must stay closed.
type R { mov h *i32, id i32 }
func drop_it(mov {h, id} R) { }
proc main() i32 {
    var p *i32 = 0
    var a R[2] = [R(p, 1), R(p, 2)]
    drop_it(mov a[0])
    drop_it(mov a[1])
    return 0
}
