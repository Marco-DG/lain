// EXPECT: [E004]
// LAINFLAGS: --engine=ir
// The nested-call co-argument conflict, ONE LEVEL DEEPER than mut_plus_nested_shared:
// the shared read of `v` is inside `length(v)`, whose result is then passed through `idf`.
// Locks that bor_collect_loans recurses rather than looking one step down — the first
// version of that fix would have passed the shallow test and missed this one.
type Vec { x i32, y i32 }
func length(v Vec) i32 { return v.x }
func idf(n i32) i32 { return n }
func scale(var v Vec, factor i32) { v.x = v.x *% factor }
func main() i32 {
    var v = Vec(2, 3)
    scale(var v, idf(length(v)))
    return v.x
}
