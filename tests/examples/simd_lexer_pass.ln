// SIMD lexer core (P4, proof_licensed_performance.md §6): SIMD whitespace skip
// (@load → compare → @movemask → @ctz) + in-guarded scalar token scan. Scalar
// reads are PROVEN (in-guards); the SIMD loads are the documented P1 unsafe
// primitive (P2b will prove them). 16-wide movemask = baseline SSE2 (harness-safe).
func is_ws(c u8) bool    { return c == 32 or c == 9 or c == 10 or c == 13 }
func is_alpha(c u8) bool { return (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95 }
func is_digit(c u8) bool { return c >= 48 and c <= 57 }
func is_alnum(c u8) bool { return is_alpha(c) or is_digit(c) }

proc count_tokens(src u8[4096], n u32) u32 {
    var count u32 = 0
    var i     u32 = 0
    while i < n {
        unsafe {
            while i +% 16 <= n {
                var v  u8x16 = @load(u8x16, src, i)
                var ws u8x16 = (v == 32) | (v == 9) | (v == 10) | (v == 13)
                var nonws u32 = (~@movemask(ws)) & (65535 as u32)
                if nonws != 0 { i = i +% (@ctz(nonws) as u32); break }
                i = i +% 16
            }
        }
        while i in src and i < n and is_ws(src[i]) { i = i +% 1 }
        if i >= n { break }
        if i in src {
            var c u8 = src[i]
            if is_alpha(c) {
                while i in src and i < n and is_alnum(src[i]) { i = i +% 1 }
            } else if is_digit(c) {
                while i in src and i < n and is_digit(src[i]) { i = i +% 1 }
            } else {
                i = i +% 1
            }
            count = count +% 1
        }
    }
    return count
}

proc main() i32 {
    var buf u8[4096] = [32 for i in 0..4096]     // all spaces
    buf[10] = 97                                  // 'a'
    buf[11] = 98                                  // 'b'
    return count_tokens(buf, 20) as i32           // one token ("ab")
}
