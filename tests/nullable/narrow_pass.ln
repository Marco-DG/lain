// ?T flow-narrowing (increment 3): inside `if x`, `if x != nil`, and after a
// guard clause `if x == nil { return }`, a ?T narrows to T (deref/pass-safe).
// Unnarrowed use is rejected (see use_without_check_fail.ln).
func use_it(p *u8) i32 { return 0 }

func via_neq(x ?*u8) i32 {
    if x != nil { return use_it(x) }
    return 0
}
func via_truthy(x ?*u8) i32 {
    if x { return use_it(x) }
    return 0
}
func via_guard(x ?*u8) i32 {
    if x == nil { return 0 }
    return use_it(x)
}
proc main() i32 { return 0 }
