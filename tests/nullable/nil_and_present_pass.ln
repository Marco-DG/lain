// ?T substrate (increment 2): nil coerces to any ?T (absent); a present T
// coerces to ?T (identity at runtime); ?T flows to ?T. Layout = the niche
// (?*T is one bare pointer, nil = null).
proc take_present(p *u8) ?*u8 {
    return p
}
proc get_absent() ?*u8 {
    return nil
}
proc main() i32 {
    var a ?*u8 = nil
    var b ?*u8 = get_absent()
    return 0
}
