// EXPECT: [E014]
// EXPECT-TEXT: Error Ln 16, Col 5: this `case` on 'Small | NotFound | Denied' has no arm for the value (an `else:` arm), Denied. Add one, or an `else:`.
// I.129: a `case` on a union names what it leaves out as the union is written: its value, which
// only an `else:` reaches, and a marker by its bare name. It named `__U_Small_NotFound_Denied.__payload`.

type Small = u8 < 200

func fs(k Small) Small | NotFound | Denied {
    if k == 1 { return NotFound }
    if k == 2 { return Denied }
    return k
}

func g(k Small) i32 {
    r Small | NotFound | Denied = fs(k)
    case r {
        NotFound: return 1
    }
    return 0
}

func main() i32 {
    return 0
}
