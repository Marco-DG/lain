extern func libc_printf(fmt *u8, ...) i32 effects io
// Optionality is `T | none` — one construct, one spelling.
func take(x *u8 | none) i32 {
    if x { return 1 }
    return 0
}
func make(p *u8, present bool) *u8 | none {
    if present { return p }
    return none
}
func main() i32 effects io {
    var a *u8 | none = make("hi", true)
    var b *u8 | none = none
    libc_printf("take(a)=%d take(b)=%d (want 1 0)\n", take(a), take(b))
    return 0
}
