// EXPECT: [E003]
// The companion to linear_adt_payload_mov_pass.ln, and the reason that one is safe to accept.
// The `Full` arm binds the linear payload and then does NOT consume it. The obligation
// transferred from the scrutinee to `ptr`, so `ptr` leaks.
//
// Both engines reject this. Only the new one also ACCEPTS the version that consumes the
// payload — which is the whole point: rejecting both is not precision, it is refusal to
// distinguish them.
import std.mem.{mem_free}
type Box {
    Full {
        ptr mov *u8
    }
    Empty
}
func noop() {
    var x = 0
}
func t(b mov Box) {
    case b {
        Full(ptr): noop()
        Empty: noop()
    }
}
func main() i32 { return 0 }
