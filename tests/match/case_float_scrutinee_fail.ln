// EXPECT: [E100]
// spec: §15 — the scrutinee types are enums, integers, `u8`, `bool` (and strings, §15.7). A
// `case` statement on an f64 was DROPPED by lowering: this function compiled to a bare
// `return;` from a u8 function, and the compiler exited 0 with a note on stderr.
func pick(x f64) u8 {
    case x {
        1.0: return 7
        else: return 9
    }
}

func main() i32 { return pick(1.0) as i32 }
