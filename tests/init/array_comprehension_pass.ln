// An array comprehension is a whole-array initializer, full by construction —
// it lowers to a fill loop (zero-cost) and the array is then fully initialized,
// so element reads are sound (no E005).
extern proc libc_printf(fmt *u8, ...) i32
proc main() i32 {
    var sq = [i * i for i in 0..8]
    var inc = [x + 1 for x in 1..=3]
    libc_printf("sq[7]=%d inc[0]=%d\n", sq[7], inc[0])
    return sq[7] - 49 + inc[0] - 2
}
