// An immutable array may be handed to an array parameter the callee only READS: its write
// footprint is empty (immutable_outparam_fail.ln is the writing case).
func total(a i32[3]) i32 {
    return a[0] +% a[1] +% a[2]
}
T i32[3] = [1, 2, 3]
func main() i32 {
    a i32[3] = [4, 5, 6]
    if total(a) != 15 or total(T) != 6 { return 1 }
    return 0
}
