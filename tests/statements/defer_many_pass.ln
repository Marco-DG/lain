    defer libc_printf("%d ", 54 as i32)
    defer libc_printf("%d ", 55 as i32)
    defer libc_printf("%d ", 56 as i32)
    defer libc_printf("%d ", 57 as i32)
    defer libc_printf("%d ", 58 as i32)
    defer libc_printf("%d ", 59 as i32)
    defer libc_printf("%d ", 60 as i32)
    defer libc_printf("%d ", 61 as i32)
    defer libc_printf("%d ", 62 as i32)
    defer libc_printf("%d ", 63 as i32)
    defer libc_printf("%d ", 64 as i32)
    defer libc_printf("%d ", 65 as i32)
    defer libc_printf("%d ", 66 as i32)
    defer libc_printf("%d ", 67 as i32)
    defer libc_printf("%d ", 68 as i32)
    defer libc_printf("%d ", 69 as i32)
    libc_printf("body: ")
}

func main() i32 effects io {
    many()
    libc_printf("\n")
    return 0
}
