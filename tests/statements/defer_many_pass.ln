// spec: §9 (defer) — every deferred statement runs, in reverse order, however many there are.
// The defer stack was a fixed 64 entries: the 65th and later were DROPPED, the function was
// marked incomplete, and it was emitted anyway with its checks skipped (64 of 70 printed).
extern func libc_printf(fmt *u8, ...) i32 effects io

func many() effects io {
    defer libc_printf("%d ", 0 as i32)
    defer libc_printf("%d ", 1 as i32)
    defer libc_printf("%d ", 2 as i32)
    defer libc_printf("%d ", 3 as i32)
    defer libc_printf("%d ", 4 as i32)
    defer libc_printf("%d ", 5 as i32)
    defer libc_printf("%d ", 6 as i32)
    defer libc_printf("%d ", 7 as i32)
    defer libc_printf("%d ", 8 as i32)
    defer libc_printf("%d ", 9 as i32)
    defer libc_printf("%d ", 10 as i32)
    defer libc_printf("%d ", 11 as i32)
    defer libc_printf("%d ", 12 as i32)
    defer libc_printf("%d ", 13 as i32)
    defer libc_printf("%d ", 14 as i32)
    defer libc_printf("%d ", 15 as i32)
    defer libc_printf("%d ", 16 as i32)
    defer libc_printf("%d ", 17 as i32)
    defer libc_printf("%d ", 18 as i32)
    defer libc_printf("%d ", 19 as i32)
    defer libc_printf("%d ", 20 as i32)
    defer libc_printf("%d ", 21 as i32)
    defer libc_printf("%d ", 22 as i32)
    defer libc_printf("%d ", 23 as i32)
    defer libc_printf("%d ", 24 as i32)
    defer libc_printf("%d ", 25 as i32)
    defer libc_printf("%d ", 26 as i32)
    defer libc_printf("%d ", 27 as i32)
    defer libc_printf("%d ", 28 as i32)
    defer libc_printf("%d ", 29 as i32)
    defer libc_printf("%d ", 30 as i32)
    defer libc_printf("%d ", 31 as i32)
    defer libc_printf("%d ", 32 as i32)
    defer libc_printf("%d ", 33 as i32)
    defer libc_printf("%d ", 34 as i32)
    defer libc_printf("%d ", 35 as i32)
    defer libc_printf("%d ", 36 as i32)
    defer libc_printf("%d ", 37 as i32)
    defer libc_printf("%d ", 38 as i32)
    defer libc_printf("%d ", 39 as i32)
    defer libc_printf("%d ", 40 as i32)
    defer libc_printf("%d ", 41 as i32)
    defer libc_printf("%d ", 42 as i32)
    defer libc_printf("%d ", 43 as i32)
    defer libc_printf("%d ", 44 as i32)
    defer libc_printf("%d ", 45 as i32)
    defer libc_printf("%d ", 46 as i32)
    defer libc_printf("%d ", 47 as i32)
    defer libc_printf("%d ", 48 as i32)
    defer libc_printf("%d ", 49 as i32)
    defer libc_printf("%d ", 50 as i32)
    defer libc_printf("%d ", 51 as i32)
    defer libc_printf("%d ", 52 as i32)
