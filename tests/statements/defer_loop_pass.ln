extern func printf(fmt *u8, ...) i32 effects io

func main() effects diverge, io {
    var i = 0
    while i < 3 {
        defer printf("-%d-", i)
        i = i + 1
        if i == 2 {
            continue
        }
        defer printf("A%d", i)
        if i == 3 {
            break
        }
    }
    printf("END")
}
