// spec: §9 — `continue` in a `for` loop starts the next iteration, so the counter steps first.
// Lowering sent it to the loop's header and skipped `i = i + 1`, so a loop that continued never
// left that value: refused as E011 ("not provably terminating") in a total function like these,
// and a hang in a function allowed to diverge. `while` was right: its step is the programmer's.
extern func libc_printf(fmt *u8, ...) i32 effects io

func range_skip() effects io {
    for i in 0..5 {
        if i == 1 { continue }
        if i == 3 { continue }
        libc_printf("%d ", i as i32)
    }
    libc_printf("| ")
}

func each_skip(a i32[4]) effects io {
    for v in a {
        if v < 0 { continue }
        libc_printf("%d ", v)
    }
    libc_printf("| ")
}

// A `while` inside a `for`: its `continue` goes to its own header, not to the outer step.
func nested() effects io {
    for i in 0..3 {
        var j = 0
        while j < 3 {
            j = j + 1
            if j == 2 { continue }
            libc_printf("%d%d ", i as i32, j)
        }
        if i == 0 { continue }
        libc_printf("i%d ", i as i32)
    }
    libc_printf("| ")
}

// A defer in the body runs on `continue` too, before the step.
func with_defer() effects io {
    for i in 0..3 {
        defer libc_printf("d%d ", i as i32)
        if i == 1 { continue }
        libc_printf("b%d ", i as i32)
    }
    libc_printf("|\n")
}

func main() i32 effects io {
    range_skip()
    t i32[4] = [1, -2, 3, -4]
    each_skip(t)
    nested()
    with_defer()
    return 0
}
