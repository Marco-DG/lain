// EXPECT: [E100]
// A `defer` inside a deferred statement was DROPPED by lowering with no mark at all, so this
// printed "outer" and never "inner". Until it is modelled it is refused at the inner `defer`.
extern func libc_printf(fmt *u8, ...) i32 effects io

func f(c bool) effects io {
    defer if c {
        defer libc_printf("inner\n")
        libc_printf("outer\n")
    }
    libc_printf("body\n")
}

func main() i32 effects io {
    f(true)
    return 0
}
