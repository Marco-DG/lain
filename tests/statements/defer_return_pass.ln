extern func printf(fmt *u8, ...) i32 effects io

func test_ret() i32 effects io {
    defer printf("2")
    return 42
}

func test_void() effects io {
    defer printf("4")
    return
}

func main() effects io {
    printf("1")
    var x = test_ret()
    printf("3")
    test_void()
    printf("-")
}
