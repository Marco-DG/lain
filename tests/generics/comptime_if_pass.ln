// Test comptime if with @os builtin
// Expected: on Linux, only the Linux branch appears in out.c

extern func printf(fmt u8[:0], ...) i32 effects io

func main() effects io {
    comptime if @os == 1 {
        printf("Running on Linux\n")
    } else {
        printf("Running on another OS\n")
    }
    printf("Done\n")
}
