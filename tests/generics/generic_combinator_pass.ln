// The core generic-programming pattern: a function generic over T that returns
// Option(T) and builds it in its body, chained directly into a consumer that
// takes Option(i32) by value (its rvalue result materialized for the pointer ABI).
type Option(T type) {
    Some { val T }
    None
}
func some(T type, x T) Option(T) {
    return Option(T).Some(x)
}
func unwrap(o Option(i32)) i32 {
    return case o {
        Some(v): v
        None: 0
    }
}
proc main() i32 {
    if unwrap(some(7)) == 7 { return 0 }
    return 1
}
