// Generic ADT with two type params: Result(T, E).
type Result(T type, E type) {
    Ok  { val T }
    Err { code E }
}
func unwrap_or(r Result(i32, i32), fallback i32) i32 {
    return case r {
        Ok(v): v
        Err(c): fallback
    }
}
proc main() i32 {
    var r Result(i32, i32) = Result(i32, i32).Ok(7)
    var e Result(i32, i32) = Result(i32, i32).Err(99)
    if unwrap_or(r, 0) == 7 {
        if unwrap_or(e, 0) == 0 { return 0 }
    }
    return 1
}
