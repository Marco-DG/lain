// EXPECT: [E124]
// I.172: an instance's name joins its arguments with `_`, and a name may hold one, so
// `Pair(My, Type_X)` and `Pair(My_Type, X)` are both `Pair_My_Type_X`. The second was the first's
// instance: `two` read `p.r.c` as X's u8 and returned it as Type_X's i64, and the program compiled
// (on the parent). Where a name is already taken, the arguments it was made from are compared,
// and a mismatch is refused.
type My_Type {
    a i32
}
type My {
    a i32
}
type X {
    c u8
}
type Type_X {
    c i64
}
type Pair(A type, B type) {
    l A
    r B
}
func one(p Pair(My_Type, X)) i32 {
    return p.l.a
}
func two(p Pair(My, Type_X)) i64 {
    return p.r.c
}
func main() i32 {
    return 0
}
