// A guard on a FIXED array's `.len` (a compile-time constant) narrows the index just
// as `i < N` would: `while i < a.len { a[i] }` proves check-free over `a i32[16]`.
// Previously only the literal bound worked; `a.len` in the guard was not folded.
func sum() i32 {
    var a i32[16] = [1 for x in 0..16]
    var s = 0
    var i usize = 0
    while i < a.len {
        s = s + a[i]
        i = i + 1
    }
    return s
}
proc main() i32 {
    if sum() == 16 { return 0 }
    return 1
}
