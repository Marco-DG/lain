// LAINFLAGS: --engine=ir-full
// ★ Pinned to the new engine, which names the BUG rather than its consequence. The defect is
// `hi = mid - 1` underflowing when mid is 0; the old engine reported the downstream [E085],
// an index it could no longer bound, while the new one says "this subtraction can go below
// zero, and 'usize' is unsigned" at the subtraction itself. Same rejection, and the second
// message is the one that tells you what to change.
// EXPECT: [E086]
// SOUNDNESS: `hi = mid - 1` on usize underflows to SIZE_MAX when mid = 0
// (lo=0, hi=1 gives mid=0). The invariant engine models arithmetic over signed
// intervals; an unsigned-underflowing subtraction is abstracted to unknown
// rather than the misleading small negative range, so no bogus bound on `hi`
// survives and `a[mid]` cannot be proven in bounds — rejected, not miscompiled.
proc bad(a i32[8], target i32) usize {
    var lo usize = 0
    var hi usize = 8
    while lo < hi decreasing hi - lo {
        var mid usize = lo + (hi - lo) / 2
        if a[mid] < target { lo = mid + 1 } else { hi = mid - 1 }
    }
    return lo
}
proc main() i32 { return 0 }
