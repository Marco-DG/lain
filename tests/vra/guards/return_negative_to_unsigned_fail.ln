// EXPECT: [E086]
// Previously a documented VRA gap ("currently passes silently"): `a - b` with
// unconstrained i32 inputs can be negative / overflow i32, and returning it to
// u32 slipped through. Under overflow prove-or-reject the subtraction's range
// (which can exceed i32) is now rejected — the gap is closed. The `as u32` cast
// does not save it: in C `a - b` is computed in int and overflows before the cast.
// To make this sound, widen first: `(a as i64 - b as i64) as u32`.
func gap(a i32, b i32) u32 {
    return (a - b) as u32
}

proc main() i32 {
    var _ = gap(5, 10)
    return 0
}
