// EXPECT: [E011]
// A loop on a flag ends only if something clears the flag. Here it is cleared once `i` reaches n,
// but `i` stops at 100, so for n > 100 the loop never ends. A loop that may run forever is
// declared with `effects diverge`.

func bad_loop(n i32) i32 {
    var i i32 = 0
    var go bool = true
    while go {
        if i < 100 {
            i = i + 1
        }
        if i >= n {
            go = false
        }
    }
    return i
}

func main() i32 {
    var _ = bad_loop(5)
    return 0
}
