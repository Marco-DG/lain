// EXPECT: [E011]
// A `while` in a `func` needs a termination measure. The measure is inferred from a
// relational condition (`i < n` → `n - i`), but a NON-relational condition like a
// bare boolean flag gives the inference nothing to work with, so it must still be
// rejected (add an explicit `decreasing` measure or use `proc`).

func bad_loop(n i32) i32 {
    var i i32 = 0
    var go bool = true
    while go {
        i = i + 1
        if i >= n {
            go = false
        }
    }
    return i
}

proc main() i32 {
    var _ = bad_loop(5)
    return 0
}
