// EXPECT: [E085]
// A guard on a nested field path (`b.i.s.len > 0`) narrows the access through it
// (tests/trust/nested_field_guard_pass.ln) only until something writes the path. Here the
// write between guard and access is a callee given `var b.i`, which writes its field through that alias, which empties the slice:
// `b.i.s[0]` is refused.
type A {
    s i32[]
}
type B {
    i A
}
func empty_into(a var A, e i32[]) {
    a.s = e
}
func f(xs i32[3], e i32[]) i32 {
    var b = B(A(xs[0..3]))
    if b.i.s.len > 0 {
        empty_into(var b.i, e)
        return b.i.s[0]
    }
    return 0
}
func main() i32 {
    xs i32[3] = [7, 8, 9]
    zs i32[1] = [0]
    if f(xs, zs[0..0]) != 7 { return 1 }
    return 0
}
