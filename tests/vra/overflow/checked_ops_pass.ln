// F3.4/Q1 checked operators: a +? b / a -? b / a *? b keep the OPERAND type and
// are handled inline by `else` — `else panic(...)` is the explicit abort bridge,
// `else <fallback>` recovers. A bare checked op is rejected (E067): abort must be
// explicit. (Path-F's `+` widens so it can't overflow; `+?` stays + is handled.)
proc main() i32 {
    var a i32 = 10
    var b i32 = 3
    var s = a +? b else panic("overflow")
    var d = a -? b else panic("overflow")
    var p = a *? b else panic("overflow")
    return s + d + p
}
