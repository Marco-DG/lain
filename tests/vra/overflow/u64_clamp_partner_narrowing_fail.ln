// EXPECT: [E086]
// I.178: the range analysis holds a u64 up to INT64_MAX, its clamp, and the relational
// refinement read a u64 partner's clamp as a true top: `v < x` gave v <= INT64_MAX - 1, so
// `v as i64` "fit", and v = 2^64 - 2 converted to -2. x's true top is 2^64 - 1, which bounds
// nothing an i64 can hold. The allowed side is tests/trust/u64_sum_under_partner_pass.ln.
func g(x u64, v u64) i64 {
    if v < x { return v as i64 }
    return 0
}
func main() i32 {
    var big u64 = 0
    big = big -% 1
    var v u64 = big -% 1
    r = g(big, v)
    if r < 0 { return 1 }
    return 0
}
