// EXPECT: [E086]
// A u16 that does not fit a u8 field is refused. It was E012 — the constructor had a private
// type-compatibility check of its own — and is now E086, the code every other boundary gives the
// same narrowing (`take_u8(big)` says E086 too): struct construction uses the one conversion
// relation since 2026-09-28. Either way the program is rejected.

type RGB {
    r u8
    g u8
    b u8
}

func main() i32 {
    var big u16 = 500
    var p = RGB(big, 0, 0)   // big doesn't fit u8 field
    var _p = p
    return 0
}
