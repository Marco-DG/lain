// EXPECT: [E086]
// Strict boundary: usize/isize -> fixed-width narrowing is fail-closed. A usize
// has no fixed width, so narrowing it to i32 can lose data (a length can exceed
// 2^31); an unproven usize -> i32 is rejected. reject_lossy_int_conversion
// previously skipped platform-type sources entirely (a silent-truncation hole).
proc f(a usize) i32 {
    var x i32 = a
    return x
}
proc main() i32 { return 0 }
