// EXPECT: [E085]
// LAINFLAGS: --engine=ir-full
// SOUNDNESS PAIR for the LOWER half of the relational refinement (vra_const_folding_pass.ln).
// A value's lower bound may be raised from a partner it is octagon-related to: `y - v <= c`
// with y bounded below by its type gives `v >= ylo - c`. That is what lets `TABLE[2] as i32 + 1`
// narrow back to an i32 — its lower bound is 1, not i33's -2^32.
//
// The same machinery must not raise a bound that is not there. `TABLE[2] as i32 - 1` is
// [-1, 254] over a u8 element, so it is NOT a valid index and the array read is refused. Get
// the sign of the relation wrong and this reads xs[-1].
TABLE u8[4] = [10, 20, 30, 40]
proc main() i32 {
    var xs i32[256] = [0 for k in 0..256]
    var j i32 = TABLE[2] as i32 - 1
    return xs[j]
}
