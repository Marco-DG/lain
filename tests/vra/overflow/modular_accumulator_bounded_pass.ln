// The companion to modular_accumulator_wraps_fail.ln: the same wrapping accumulator, ten steps.
// Its bound [100, 110] fits u8, so no step can have wrapped and the bound is exact — `s - 100`
// fits a u8. A wrapping operator does not cost the proof where it does not wrap.
func main() i32 {
    var s u8 = 100
    var i u32 = 0
    while i < 10 {
        s = s +% 1
        i = i + 1
    }
    var t u8 = s - 100
    if t != 10 { return 1 }
    return 0
}
