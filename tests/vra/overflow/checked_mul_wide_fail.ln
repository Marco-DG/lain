// LAINFLAGS: --engine=ir-full
// EXPECT: [E086]
// The teeth for checked_mul_keeps_value_pass.ln. Carrying a copy's interval must not invent one:
// these operands are refined only to i32's own range, so the checked multiply's result is
// anything that fits i32 and doubling it does not.
func twice(a i32, b i32) i32 {
    var p = a *? b else 0
    return p + p
}

func main() i32 { return 0 }
