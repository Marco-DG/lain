// EXPECT: [E085]
// A lane of a vector reached through a struct field is bounds-checked like any other index:
// a u32x4 has lanes 0..3. The lane is addressed IN the field (so a write reaches it), and the
// analysis reads the lane count off the pointer's vector type.
type Pair {
    v u32x4
    n u32
}
func main() i32 {
    var p = Pair([5, 6, 7, 8], 9)
    var k usize = 4
    p.v[k] = 1
    return 0
}
