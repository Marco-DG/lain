// Elements of a slice parameter are unbounded, so `a[i] + b[i]` is a real overflow and
// prove-or-reject refuses it. This test's subject is the dependent length `i32[out.len]`, not arithmetic, so the
// addition is explicitly wrapping (`+%`) — which states the intent rather than
// relying on an engine that was not looking.
// Lock: value-dependent array sizing (i32[out.len]) — the DML-style feature that MUST survive.
proc vadd(var out i32[], a i32[out.len], b i32[out.len]) {
    for i in 0..out.len {
        out[i] = a[i] +% b[i]
    }
}
proc main() i32 { return 0 }
