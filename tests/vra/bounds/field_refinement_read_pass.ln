// A refined struct field carries its invariant to use sites. `v i32 >= 0 and <= 3`
// was enforced only at construction; now `a[b.v]` is provable in bounds (and
// `b.pct + 1` provable non-overflowing) because a member read seeds the field's
// refinement range.
//
// The IR engine reads the same declaration: a field's refinement clauses now reach its
// lowered type (`IrType.has_refine`), which only the ALIAS form used to do, so a refined
// field lowered to a bare `i32` and this proof was lost under `--engine=ir-full`.
// Trusting it at the use site is sound because construction and every assignment enforce
// it — `field_refinement_violated_fail.ln` is the pair that pins that.
type Box {
    v   i32 >= 0 and <= 3
    pct i32 >= 0 and <= 100
}
func get(b Box, a i32[4]) i32 {
    return a[b.v]
}
func inc(b Box) i32 {
    return b.pct + 1
}
func main() i32 {
    var b = Box(2, 50)
    var xs i32[4] = [10, 20, 30, 40]
    return get(b, xs)
}
