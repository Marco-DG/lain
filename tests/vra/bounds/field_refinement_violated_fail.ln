// EXPECT: [E086]
// SOUNDNESS PAIR for field_refinement_read_pass.ln. The bounds proof there trusts a field's
// declared refinement at the USE site (`a[b.v]` with `v i32 >= 0 and <= 3`), which is only
// sound because every way of putting a value into that field enforces it. This pins the
// construction route; `b.v = 99` after the fact and a write through a `var Box` parameter are
// both rejected the same way.
//
// If this program ever compiles, `field_refinement_read_pass.ln` is a FALSE PROOF and not a
// precision win: the index would be 99 on a 4-element array with the bounds check removed.
type Box {
    v   i32 >= 0 and <= 3
    pct i32 >= 0 and <= 100
}
func get(b Box, a i32[4]) i32 {
    return a[b.v]
}
proc main() i32 {
    var b = Box(99, 50)
    var xs i32[4] = [10, 20, 30, 40]
    return get(b, xs)
}
