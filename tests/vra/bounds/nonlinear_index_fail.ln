// EXPECT: [E085]
// Lock: a non-linear index expression cannot be proven in bounds STATICALLY
// (Fourier-Motzkin is linear), and the arithmetic is provably overflow-free from
// the input refinements — so the remaining failure is the non-linear bounds proof.
// (A matching `in` runtime guard WOULD prove it soundly — see char_guarded_compound_index_pass;
// the point here is the static path, with no guard.)
func at(m i32[], cols i32 >= 0 and < 1000, r i32 >= 0 and < 1000, c i32 >= 0 and < 1000) i32 {
    return m[r * cols + c]
}
proc main() i32 { return 0 }
