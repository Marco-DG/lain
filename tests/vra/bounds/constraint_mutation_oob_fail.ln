// EXPECT: [E085]
// SOUNDNESS lock (constraint counterpart of char_guard_mutation_oob_fail): the
// bounds prover chains the loop guard's constraint `i < n` with n's range to
// prove `src[i]`. That constraint goes stale the moment `i` is reassigned, so
// `while i < n { i = i +% 1000; src[i] }` must be REJECTED — the mutated `i` is
// out of range and the chained proof must not survive the mutation.
proc t(src u8[4096], n u32 < 4097) u8 {
    var i u32 = 0
    var r u8 = 0
    while i < n {
        i = i +% 1000
        r = src[i]
        i = i +% 1
    }
    return r
}
proc main() i32 { return 0 }
