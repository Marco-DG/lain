// Test: 'in' as bounds-proving condition in while and if
extern proc libc_printf(fmt *u8, ...) i32


// The index is a `usize` and "not found" is the LENGTH — the same idiom the README's `find`
// uses. An i32 counter bounded by a usize length is the A1 survey's `narrow-counter` class:
// `i` can reach INT32_MAX while still below `data.len`, so `i + 1` really can overflow, and
// the engine is right to refuse it. As a usize, `i < data.len` bounds it relationally against
// the length's own type and the step proves.
//
// `i +% 1` is NOT the fix here: a wrapping step defeats the termination measure — the
// inference needs a recognisable decrease, and a counter that wraps is not a well-founded
// witness. Wrapping is an escape from the overflow obligation, never from totality.
func find_char(data u8[:0], target i32) usize {
    var i usize = 0
    while i in data decreasing data.len - i {
        if (data[i] as i32) == target { return i }
        i = i + 1
    }
    return data.len
}

func peek_safe(data u8[:0], pos i32) i32 {
    if pos in data { return data[pos] as i32 }
    return 0
}

proc main() i32 {
    var result = find_char("hello", 'l')
    libc_printf("find_char: %zu\n", result)
    libc_printf("peek_safe: %d\n", peek_safe("abc", 1))
    return 0
}
