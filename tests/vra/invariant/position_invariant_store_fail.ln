// EXPECT: [E121]
// A field write must keep it: pos 5 over a 4-byte source.
type Lexer {
    src u8[]
    pos usize <= src.len
}
type Buf {
    cap usize
    len usize <= cap
}
func bump(x var usize) { x = 99 }
func main() i32 {
    var buf u8[4] = [1, 2, 3, 4]
    var l = Lexer(buf, 0)
    l.pos = 5
    return 0
}
