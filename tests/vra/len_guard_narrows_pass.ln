// A `.len` guard on a sized slice narrows the LENGTH, so the natural non-emptiness /
// bound idioms prove the access — `a.len == n` for `a i32[n]`, so `if a.len > 0` is
// exactly `if n > 0`. Previously only the scalar `n` form was accepted; the `.len`
// form (what you write when there is no length parameter in scope) was rejected.
func first(a i32[n], n usize) i32 {
    if a.len > 0 {
        return a[0]
    }
    return 0
}
func at(a i32[n], n usize, k usize) i32 {
    if k < a.len {
        return a[k]
    }
    return 0
}
func nonempty2(a i32[n], n usize) i32 {
    if a.len >= 2 {
        return a[1]
    }
    return 0
}
proc main() i32 {
    var a i32[3] = [7, 8, 9]
    if first(a, 3) == 7 {
        if at(a, 3, 2) == 9 {
            if nonempty2(a, 3) == 8 {
                return 0
            }
        }
    }
    return 1
}
