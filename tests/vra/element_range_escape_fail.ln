// EXPECT: [E086]
// LAINFLAGS: --engine=ir-full
// SOUNDNESS PAIR for element_range_pass.ln, second condition. A callee handed the array's
// ADDRESS can store anything into it, with no IR_STORE here for the join to see — the same
// hole that produced three false proofs on 2026-09-09 in the termination and trip-count rules.
// `V->escaped` is the set the memory model already havocs at every call, and an escaped cell
// keeps no element range.
//
// The third condition is coverage: every index in [0, len) must be written by a store the scan
// can see, or declared by an IR_INIT fact. Without it a load could read an element nothing
// wrote, and the join would describe a value that element never held.
func bump(var v i32[2], k i32) { v[0] = k }
func f(k i32) i32 {
    var a i32[2] = [1, 2]
    bump(var a, k)
    return a[0] + a[1]
}
func main() i32 { return 0 }
