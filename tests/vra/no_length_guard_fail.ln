// EXPECT: [E085]
// SOUNDNESS: without the `a.len != b.len` guard, b.len may differ from a.len, so
// `b[i]` under `i < a.len` is not proven.
func f(a u8[], b u8[]) i32 {
    var i usize = 0
    while i < a.len decreasing a.len - i {
        if a[i] != b[i] {
            return 0
        }
        i = i + 1
    }
    return 1
}
proc main() i32 { return 0 }
