// A store through a `var` struct parameter is a store to THAT field cell. It was treated as an
// unattributable write — it erased every escaped fact and never recorded the value — so
// `l.k = 5; l.k - 5` could not prove the subtraction, nor `l.d = 5; 100 / l.d` the division.
type L {
    xs u8[4]
    k usize
    d i32
}
func f(l var L) usize {
    l.k = 5
    return l.k - 5
}
func g(l var L) i32 {
    l.d = 5
    return 100 / l.d
}
func h(l var L) u8 {
    l.k = 2
    return l.xs[l.k]
}
func main() i32 {
    var l = L([1, 2, 3, 4], 0, 1)
    a = f(var l)
    b = g(var l)
    c = h(var l)
    if a != 0 or b != 20 or c != 3 { return 1 }
    return 0
}
