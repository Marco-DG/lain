// EXPECT: [E100]
// An unmodelled construct is reported FIRST, at its own line. Lowering makes it an opaque —
// an unknown value that may write anything — so `is_space` became an unknown writer, `skip`
// lost every fact about `l.pos`, and the compiler reported E086, E121 and E011 on the correct
// loop below while saying nothing about the table. (Found by the Handwriting session.) The
// table that was unmodelled then, a module comprehension calling a function, is computed at
// compile time now (module_const_from_call_pass.ln); a comprehension in EXPRESSION position is
// still not modelled, and is the unmodelled construct here.
func first(a u8[4]) u8 { return a[0] }
func is_space(c u8) bool { return (first([c for i in 0..4]) & 1) != 0 }
type Lexer {
    src u8[]
    pos usize <= src.len
}
func skip(l var Lexer) {
    while l.pos < l.src.len and is_space(l.src[l.pos]) { l.pos = l.pos + 1 }
}
func main() i32 { return 0 }
