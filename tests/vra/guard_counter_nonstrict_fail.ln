// LAINFLAGS: --engine=ir-full
// EXPECT: [E086]
// Teeth for guard_counter_offset_pass.ln. The comparison must be STRICT: `i + 1 <= n` gives
// i_prev <= n - 1 rather than n - 2, so i = i_prev + 1 <= n and `i + 1` reaches n + 1, which
// leaves the type when n is at its maximum. Here n is a plain usize; a slice's length could not
// be at the maximum (§types.slice), see guard_counter_slice_bound_pass.ln.
func count(n usize) usize effects diverge {
    var i usize = 0
    while i + 1 <= n {
        i = i + 1
    }
    return i
}

func main() i32 { return 0 }
