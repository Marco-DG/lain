// EXPECT: [E085]
// SOUNDNESS: the flattened index must match the array size — `a[i*9+j]` (stride 9)
// over a[64] reaches ~70 > 64. Rejected, not miscompiled.
proc f(a i32[64]) i32 {
    var s i32 = 0
    var i usize = 0
    while i < 8 decreasing 8 - i {
        var j usize = 0
        while j < 8 decreasing 8 - j {
            s = s +% a[i * 9 + j]
            j = j + 1
        }
        i = i + 1
    }
    return s
}
proc main() i32 { return 0 }
