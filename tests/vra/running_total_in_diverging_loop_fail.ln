// EXPECT: [E086]
// EXPECT-TEXT: Error Ln 18, Col 17: this running total can overflow the type it is stored in
// I.159, the other side: a running total's E086 is a note under its loop's E011 only when there IS
// an E011. A function that declares `effects diverge` may loop for ever, so its loop owes no
// termination proof, and a total with no bound in it is an error of its own: the loop may run long
// enough to overflow it.
func is_leap(y i32 >= 0) bool {
    return (y % 4 == 0 and y % 100 != 0) or y % 400 == 0
}

func year_of(days0 u32) i32 effects diverge {
    var days u32 = days0
    var year i32 = 1980
    while days > 365 {
        if is_leap(year) {
            if days > 366 {
                days = days - 366
                year = year + 1
            }
        } else {
            days = days - 365
            year = year + 1
        }
    }
    return year
}

func main() i32 effects diverge { return year_of(10593) }
