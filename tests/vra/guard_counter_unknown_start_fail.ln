// LAINFLAGS: --engine=ir-full
// EXPECT: [E086]
// Teeth for guard_counter_offset_pass.ln. The inductive argument covers every entry AFTER the
// first; the first is covered by checking the counter's initial value directly. An entry value
// the compiler cannot see could already be at the type's maximum, and then `i + 1` overflows
// before the loop has run once.
proc sw(a i32[n], n usize, start usize) i32 {
    var s i32 = 0
    var i usize = start
    while i + 1 < n {
        s = s +% a[i]
        i = i + 1
    }
    return s
}

proc main() i32 { return 0 }
