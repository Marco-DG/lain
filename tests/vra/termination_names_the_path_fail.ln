// EXPECT: [E011]
// EXPECT-TEXT: the test at Ln 16, Col 12 is true and the test at Ln 17, Col 16 is false, so this measure does not cover every way round the loop
// I.165: an E011 names the path round the loop on which the counter does not move. It said only
// "no measure could be inferred", and the reader of the Zune 30's ConvertDays (31 Dec 2008) had to
// find for themselves that on the last day of a leap year, `is_leap_year(year)` true and
// `days > 366` false, neither `days` nor anything else changes. That path is what the analysis
// already found; the E011 now says it.
func is_leap_year(y i32 >= 0) bool {
    return (y % 4 == 0 and y % 100 != 0) or y % 400 == 0
}

func year_of(days0 u32) i32 {
    var days u32 = days0
    var year i32 = 1980
    while days > 365 {
        if is_leap_year(year) {
            if days > 366 {
                days = days - 366
                year = year + 1
            }
        } else {
            days = days - 365
            year = year + 1
        }
    }
    return year
}

func main() i32 { return 0 }
