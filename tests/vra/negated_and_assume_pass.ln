// `if !((lo <= y) and (y <= hi)) { return 0 }` is how an SV-COMP `assume(lo <= y && y <= hi)` reads
// once translated (14 of the 127 PE.11 ports). As a value, `A and B` is a bool cell and `!` compares
// it with 0, so neither of y's facts reached the edge that goes on, and `y + 1` below was E086
// under the judge and VRA alike, while the same test spelled `y < lo or y > hi` proved. A `!` in a
// branch is its operand's branch with the targets swapped, each comparison on its own edge.
func assume_not_and(y0 i32) i32 {
    var y = y0
    if !((-100 <= y) and (y <= 2147483646)) { return 0 }
    return y + 1
}

func assume_not_or(y0 i32) i32 {
    var y = y0
    if !((y < -100) or (y > 2147483646)) { return y + 1 }
    return 0
}

// one comparison negated: `!(y <= hi)` was `(y <= hi) == 0`, a value, and lost y's fact too
func assume_not_cmp(y0 i32) i32 {
    var y = y0
    if !(y <= 2147483646) { return 0 }
    return y + 1
}

// a bool negated twice: the targets swapped back
func twice(y0 i32) i32 {
    var y = y0
    if !(!(y <= 2147483646)) { return y + 1 }
    return 0
}

func main() i32 {
    if assume_not_and(3) != 4 or assume_not_and(-200) != 0 { return 1 }
    if assume_not_or(3) != 4 or assume_not_or(2147483647) != 0 { return 2 }
    if twice(3) != 4 or twice(2147483647) != 0 { return 3 }
    if assume_not_cmp(3) != 4 or assume_not_cmp(2147483647) != 0 { return 4 }
    return 0
}
