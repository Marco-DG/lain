// VRA: `x & (N-1)` for a power-of-two N is provably in [0, N-1] for ANY x — the
// AND clears bits and a non-negative mask keeps the result non-negative and <= mask.
// This proves the ubiquitous masked-index / gather idiom in bounds check-free, even
// when x's own range is unknown (a runtime array element).
proc gather(a i32[64], idx u32[8]) i32 {
    var s i32 = 0
    var i usize = 0
    while i < 8 decreasing 8 - i {
        var j usize = (idx[i] & 63) as usize
        s = s +% a[j]
        i = i + 1
    }
    return s
}
proc main() i32 { return 0 }
