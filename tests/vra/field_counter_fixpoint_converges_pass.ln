// The numeric fixpoint must converge on a loop whose counter is a struct FIELD, a reference, or
// a whole-struct store. It did not: selective widening widens only the cells a loop STORES to,
// and it marked the slot the store NAMES — a fresh field_ptr each iteration — while the transfer
// writes the CANONICAL field cell (or the cell a reference holds). The cell really written was
// never widened, climbed one step per sweep, and hit the bound: "internal error: the numeric
// fixpoint did not converge", on the simplest lexer loop there is.
//
// `effects diverge` because termination of a field counter is not inferred yet — this test is
// about the fixpoint, which runs regardless.
type L {
    src u8[]
    pos usize
}
func by_field(l var L) effects diverge {
    while l.pos < l.src.len { l.pos = l.pos + 1 }
}
func by_whole(l var L) effects diverge {
    n = l.src.len
    while l.pos < n { l = L(l.src, l.pos + 1) }
}
func by_ref(s u8[]) usize effects diverge {
    var pos usize = 0
    var r = var pos
    while r < s.len { r = r + 1 }
    return pos
}
func main() i32 effects diverge {
    var buf u8[4] = [1, 2, 3, 4]
    var a = L(buf, 0)
    while a.pos < a.src.len { a.pos = a.pos + 1 }
    var b = L(buf, 0)
    by_field(var b)
    var c = L(buf, 0)
    by_whole(var c)
    if a.pos != 4 or b.pos != 4 or c.pos != 4 or by_ref(buf) != 4 { return 1 }
    return 0
}
