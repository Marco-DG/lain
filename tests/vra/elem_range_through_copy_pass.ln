// LAINFLAGS: --engine=ir-full
// Element ranges survive a WHOLE-ARRAY COPY. `var a i32[4] = b` has value semantics and lowers
// to an element-wise `store(a[q], load(b[q]))`, so every stored value is a LOAD — and the seed
// pass admitted only stores of a KNOWN CONSTANT. Reading `b` directly proved and reading the
// copy did not, though the copy holds exactly what the source holds.
//
// The loaded value is one of the source cell's values, so the source's own element join bounds
// it. That join is over every store to the source anywhere in the function, and an escaping
// cell has already been dropped, which is what makes borrowing it sound.
proc main() i32 {
    var b i32[4] = [5, 6, 7, 8]
    var a i32[4] = b
    var c i32[4] = a          // a copy of a copy: needs a second round
    return c[2] + c[3] - 15
}
