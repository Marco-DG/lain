// EXPECT: [E085]
// SOUNDNESS: `hi` starts at 64 but the array has only 8 elements, so the
// midpoint index reaches up to 63 — out of bounds. The invariant `hi <= 8`
// does NOT hold (entry hi=64), so `a[mid]` is correctly rejected.
proc bad(a i32[8], target i32) usize {
    var lo usize = 0
    var hi usize = 64
    while lo < hi decreasing hi - lo {
        var mid usize = lo + (hi - lo) / 2
        if a[mid] < target { lo = mid + 1 } else { hi = mid }
    }
    return lo
}
proc main() i32 { return 0 }
