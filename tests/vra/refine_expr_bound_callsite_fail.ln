// EXPECT: [E012]
// ★ THE CALLER IS HELD TO AN EXPRESSION BOUND (C6, the other fail-closed half).
//
// An entry `assume` is only sound if somebody PROVED it. The call-site half rebuilds the same
// additive bound out of the caller's argument values and asserts it, so the callee's assume is
// licensed by a real obligation rather than believed.
//
// Getting this wrong would have been invisible: the parser would accept the richer bound, the
// callee would prove more, and nothing would emit the assert — an unlicensed assume, which is
// the one hazard the contract machinery exists to prevent. Here `i = 9` against `n = 4` is
// refused.
func window(a i32[n], n usize >= 2, i usize <= n - 2) i32 { return a[i] +% a[i + 1] }
func main() i32 {
    var arr i32[4] = [1, 2, 3, 4]
    return window(arr, 4, 9)
}
