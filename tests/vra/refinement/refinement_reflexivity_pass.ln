// Argument-refinement reflexivity: forwarding an IMMUTABLE parameter that already
// carries the exact refinement (`n != 0`) into a same-refinement callee discharges
// the precondition with no runtime check — refinement subtyping in miniature. The
// binding is immutable, so its refinement cannot have been invalidated.
func need_nz(b i32 != 0) i32 { return 100 / b }
func fwd(n i32 != 0) i32 { return need_nz(n) }
proc main() i32 { return 0 }
