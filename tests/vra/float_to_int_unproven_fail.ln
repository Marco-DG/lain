// with no range check; the value exceeded 32767. C's conversion is then undefined (C11 6.3.1.4),
// and `bh as i16` compiled to `(int16_t)v0` with no proof asked: the analysis tracks no float, and
// its narrowing check returned early for a source that is not an integer.
func horizontal_bias(bh f64) i16 {
    // a guard `if bh >= -32768.0 and bh < 32768.0` proves it, as `as|` and `as?` define it
    return bh as i16
}

