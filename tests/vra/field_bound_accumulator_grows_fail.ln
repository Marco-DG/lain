// EXPECT: [E086]
// ...and a bound a call can grow gives no trip count, so the u8 accumulator is not bounded by one.
type B {
    len usize
    cap usize
}
func grow(b var B) {
    if b.cap < 1000 { b.cap = b.cap + 1 }
}
func main() i32 {
    var b = B(0, 8)
    var s u8 = 0
    while b.len < b.cap {
        s = s + 1
        b.len = b.len + 1
        grow(var b)
    }
    return s as i32
}
