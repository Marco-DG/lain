// EXPECT: [E011]
// EXPECT-TEXT: note: `s` grows by 1 on every trip (Ln 17), so it stays within `u8` only if the loop runs a limited number of times
// ...and a bound a call can grow gives no trip count, so the u8 accumulator is not bounded by one.
// The loop is not shown to end either (E011), and since I.159 the unbounded total is reported as a
// note under that error rather than as an E086 of its own.
type B {
    len usize
    cap usize
}
func grow(b var B) {
    if b.cap < 1000 { b.cap = b.cap + 1 }
}
func main() i32 {
    var b = B(0, 8)
    var s u8 = 0
    while b.len < b.cap {
        s = s + 1
        b.len = b.len + 1
        grow(var b)
    }
    return s as i32
}
