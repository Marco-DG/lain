// EXPECT: [E086]
// ...and a bound a call can grow does not keep the trip count at 8. grow() raises b.cap by one a
// trip until it reaches 1000, and b.len rises by one a trip, so the loop would end after 1000
// trips. The u8 total counts every trip, so `s + 1` overflows on the 256th.
type B {
    len usize
    cap usize
}
func grow(b var B) {
    if b.cap < 1000 { b.cap = b.cap + 1 }
}
func main() i32 {
    var b = B(0, 8)
    var s u8 = 0
    while b.len < b.cap {
        s = s + 1
        b.len = b.len + 1
        grow(var b)
    }
    return s as i32
}
