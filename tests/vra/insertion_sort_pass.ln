// Full insertion sort compiles CHECK-FREE: the nested-loop predecessor `a[j-1]`
// (j starts at i, j > 0 in the guard, decreasing) proves in bounds over a dynamic
// slice a[n]. The bounds prover chains `j <= i` (var j = i) + `i < n` (outer guard)
// to `j < n`, and the offset -1 (a[j-1]) shifts the constraint threshold, with the
// lower bound `j-1 >= 0` supplied by the `j > 0` guard.
proc isort(var a i32[n], n usize) {
    var i usize = 1
    while i < n decreasing n - i {
        var j usize = i
        while j > 0 decreasing j {
            if a[j - 1] > a[j] {
                var tmp i32 = a[j]
                a[j] = a[j - 1]
                a[j - 1] = tmp
            }
            j = j - 1
        }
        i = i + 1
    }
}
proc main() i32 {
    var a i32[4] = [3, 1, 4, 2]
    isort(var a, 4)
    return a[0]
}
