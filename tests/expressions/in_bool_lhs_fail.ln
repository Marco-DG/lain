// EXPECT: [E012]
// EXPECT-TEXT: Error Ln 6, Col 8: `x in lo..hi` tests an integer against a range of integers; the left side is 'bool'
// The left side of `in` is an index, so it is an integer: `true in 0..a.len` compiled and meant `1 < a.len`
// (I.75).
func f(b bool, a u8[]) i32 {
    if b in 0..a.len {
        return 1
    }
    return 0
}

func main() i32 {
    var a u8[3] = [1, 2, 3]
    return f(true, a)
}
