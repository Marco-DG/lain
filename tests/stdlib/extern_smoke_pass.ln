extern func abs(n i32) i32 effects
extern func malloc(size usize) mov *void effects io, alloc
extern func free(ptr mov *void) effects io
extern func exit(status i32) effects io

// Also test stdlib which uses extern
import std.io.{print, println}
func main() i32 effects io, alloc {
    println("Testing extern keyword...")

    // Test abs
    var n i32 = -42
    var res i32 = abs(n)
    if (res != 42) {
        println("Error: abs(-42) failed")
        return 1
    }
    println("abs(-42) = 42 (OK)")

    // Test malloc/free with proper ownership
    var ptr = malloc(10)
    // Free with explicit mov (ownership transfer)
    free(mov ptr)
    println("malloc and free (OK)")

    println("All extern tests passed.")
    exit(0)
    return 0
}
