import std.c.{FILE, printf, fopen, fclose, fputs, fgets, libc_printf, libc_puts}
import std.fs.{File, open_file, close_file, write_file}
proc main() i32 {
    var msg_open = "Opening file: test_output.txt\n"
    libc_printf(msg_open.data)
    
    var path = "test_output.txt"
    var mode = "w"
    var f = open_file(path, mode)
    
    var msg_write = "Writing to file...\n"
    libc_printf(msg_write.data)
    
    var content = "Hello from Lain std/fs!\n"
    write_file(f, content)
    
    libc_printf("Closing file...\n")
    close_file(mov f)
        
    libc_printf("Done.\n")
    return 0
}
