/*
    Three Pointers Approach:

    We will start from the end of each array, comparing them and taking the maximum one,
    we'll insert it at the end of the first array.
*/

func merge(m i32 >= 0, n i32 >= 0, var nums1 *i32[m + n], nums2 *i32[n]) {
    p1  = &nums1[m]
    p2  = &nums2[n]
    out = &nums1[m + n]

    while p1 > nums1 and p2 > nums2 {
        if *(p1 - 1) > *(p2 - 1) {*(out - 1) = *(p1 - 1); p1 -= 1 }
        else                     {*(out - 1) = *(p2 - 1); p2 -= 1 }
        out -= 1
    }
    while p2 > nums2 {
        *(out - 1) = *(p2 - 1);
        p2 -= 1;
        out -= 1
    }
}