import ctype

type TokenKind {
    Eof
    Ident
    Number
    Plus
    Minus
    Star
    Slash
    LParen
    RParen
    Assign
    Unknown
}

type Token {        // 16 bytes
    pos  u64        // 8 bytes
    len  u16        // 2 bytes
    kind TokenKind  // 1 byte
                    // padding 5 bytes
}

type Lexer {        // 24 bytes
    src u8[]        // 16 bytes: a slice is {data, len}
    pos usize <= src.len
}

assert @sizeof(TokenKind) == 1
assert @sizeof(Token) == 16
assert @sizeof(Lexer) == 24

func lexer_new(text u8[]) Lexer {
    return Lexer(text, 0)
}

func lexer_next(l var Lexer) Token {

}
