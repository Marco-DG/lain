/* TODO: currently we treat src as null terminated string,
    but getting the src lenght would be a single syscall.
    known len would allow better vectorization

    I could do:

        type Lexer {            // 16 Bytes
            src  *u8[len]
            len   u32
            pos   u32 in src    // Max file size is ~ 4 GB
        }

*/


import token.{Token, TokenKind}
import ctype.{is_alpha, is_alnum, is_digit, is_space}

type Lexer {          // 16 Bytes
    src u8[]          // A slice is {data, len}
    pos u32 in src    // Max file size is ~ 4 GB
                      // Unused padding is 4 bytes
}

func lexer_new(text u8[:0]) Lexer {
    return Lexer(text, 0)
}

func lexer_next(l *Lexer) Token {
    // ...
}