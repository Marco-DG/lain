# Everything private lives in one place. Working notes, research, the vendored
# toolchain, old versions: none of it is product, all of it stays on disk.
local/

# The compiler itself, and anything a build leaves behind.
lain
*.o
*.obj
*.exe
*.elf
*.dbg
*.out
out.c
lain.h
*.dot
# extensionless binaries left by ad-hoc gcc runs
/arena_list_out
/lain_dbg
/lain_new
/lexer_test
/out_test
/ownership
/test_destruct
/test_main
/unsafe_nested
/unsafe_valid
/out/
/test_out/
/fuzz_bugs/

# Scratch
*_scratch.ln
_*.ln
debug_out.txt
test_output.txt*
tests/**/out
tests/**/out.c
tests/**/lain.h
src/lainc

# Editor / OS / agent
.claude/
.DS_Store
_backups/

# spec/ SOURCES are tracked: the contract has to be reviewable and diffable.
# Only the LaTeX build products are ignored, and the built PDF is kept.
spec/**/*.aux
spec/**/*.log
spec/**/*.toc
spec/**/*.out
spec/**/*.idx
spec/**/*.ind
spec/**/*.ilg
spec/**/*.lot
spec/**/*.lof
spec/**/*.fls
spec/**/*.fdb_latexmk
spec/**/*.synctex.gz
spec/**/*.bbl
spec/**/*.blg
!spec/lain-spec.pdf

# handwritten/ is Marco's own working code; its build output is not tracked.
handwritten/leetcode/*.c
handwritten/leetcode/*.txt
handwritten/leetcode/update_compiler.sh
handwritten/main.ln

# Design notes and the engine theses are working documents, not deliverables.
design/
thesis/
